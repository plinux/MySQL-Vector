# Result differences depending on FS case sensitivity.
if (!$require_case_insensitive_file_system)
{
  --source include/have_case_sensitive_file_system.inc
}

--source include/have_vector_index.inc

SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES';

SELECT COUNT(*) AS vector_libraries_table_count
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES';

SELECT COLUMN_NAME, DATA_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES'
ORDER BY ORDINAL_POSITION;
