#
# WL#vector-v1: configure DISKANN build worker count
#
SET GLOBAL vector_diskann_build_threads=2;
SELECT @@global.vector_diskann_build_threads;
@@global.vector_diskann_build_threads
2
SELECT VEC_INDEX_CREATE('idx_diskann_thread_global', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN');
VEC_INDEX_CREATE('idx_diskann_thread_global', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN')
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_global'),
'$.diskann_build_threads') AS inherited_threads;
inherited_threads
2
SELECT VEC_INDEX_CREATE('idx_diskann_thread_stmt', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 3);
VEC_INDEX_CREATE('idx_diskann_thread_stmt', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 3)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_stmt'),
'$.diskann_build_threads') AS statement_threads;
statement_threads
3
SELECT VEC_INDEX_CREATE('idx_diskann_thread_zero', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0);
VEC_INDEX_CREATE('idx_diskann_thread_zero', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_zero'),
'$.diskann_build_threads') AS statement_zero_threads;
statement_zero_threads
2
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_thread_stmt',
48, 96, 4);
VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_thread_stmt',
48, 96, 4)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_stmt'),
'$.diskann_max_degree') AS max_degree,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_stmt'),
'$.diskann_build_complexity') AS build_complexity,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_thread_stmt'),
'$.diskann_build_threads') AS build_threads;
max_degree	build_complexity	build_threads
48	96	4
SHOW VECTOR STATUS FOR INDEX 'idx_diskann_thread_stmt'
WHERE Variable_name = 'idx_diskann_thread_stmt.diskann_max_degree';
Section	Variable_name	Value
INDEX_STATE	idx_diskann_thread_stmt.diskann_max_degree	48
SHOW VECTOR STATUS FOR INDEX 'idx_diskann_thread_stmt'
WHERE Variable_name LIKE 'idx_diskann_thread_stmt.diskann_build_%';
Section	Variable_name	Value
INDEX_STATE	idx_diskann_thread_stmt.diskann_build_complexity	96
INDEX_STATE	idx_diskann_thread_stmt.diskann_build_threads	4
DROP TABLE IF EXISTS t_diskann_thread_ddl;
CREATE TABLE t_diskann_thread_ddl(id INT PRIMARY KEY, v VECTOR(2));
CREATE VECTOR INDEX ON t_diskann_thread_ddl(v)
WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN', 4);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('test.t_diskann_thread_ddl.v'),
'$.diskann_build_threads') AS ddl_threads;
ddl_threads
4
SHOW VECTOR STATUS FOR INDEX 'test.t_diskann_thread_ddl.v'
WHERE Variable_name = 'test.t_diskann_thread_ddl.v.diskann_build_threads';
Section	Variable_name	Value
INDEX_STATE	test.t_diskann_thread_ddl.v.diskann_build_threads	4
SELECT VEC_INDEX_CREATE('idx_diskann_thread_bad', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 65536);
ERROR HY000: Incorrect arguments to vec_index_create
DROP TABLE IF EXISTS t_diskann_thread_bad;
CREATE TABLE t_diskann_thread_bad(id INT PRIMARY KEY, v VECTOR(2));
CREATE VECTOR INDEX ON t_diskann_thread_bad(v)
WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN', 65536);
ERROR HY000: Incorrect arguments to CREATE VECTOR INDEX
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_thread_stmt',
48, 96, 65536);
ERROR HY000: Incorrect arguments to vec_index_set_diskann_build_params
DROP TABLE t_diskann_thread_bad;
DROP TABLE t_diskann_thread_ddl;
SELECT VEC_INDEX_DROP('idx_diskann_thread_stmt');
VEC_INDEX_DROP('idx_diskann_thread_stmt')
1
SELECT VEC_INDEX_DROP('idx_diskann_thread_global');
VEC_INDEX_DROP('idx_diskann_thread_global')
1
SELECT VEC_INDEX_DROP('idx_diskann_thread_zero');
VEC_INDEX_DROP('idx_diskann_thread_zero')
1
SET GLOBAL vector_diskann_build_threads=DEFAULT;
