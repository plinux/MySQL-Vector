SELECT @@global.vector_faiss_keep_loaded;
@@global.vector_faiss_keep_loaded
1
SHOW GLOBAL VARIABLES LIKE 'vector_faiss_keep_loaded';
Variable_name	Value
vector_faiss_keep_loaded	ON
SHOW SESSION VARIABLES LIKE 'vector_faiss_keep_loaded';
Variable_name	Value
vector_faiss_keep_loaded	ON
SELECT @@session.vector_faiss_keep_loaded;
ERROR HY000: Variable 'vector_faiss_keep_loaded' is a GLOBAL variable
SET GLOBAL vector_faiss_keep_loaded=OFF;
