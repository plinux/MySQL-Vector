CREATE VECTOR INDEX ON t_faiss_thread_bad(v)
WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS', 65536);
ERROR HY000: Incorrect arguments to CREATE VECTOR INDEX
DROP TABLE t_faiss_thread_bad;
DROP TABLE t_faiss_thread_ddl;
SELECT VEC_INDEX_DROP('idx_faiss_thread_stmt');
VEC_INDEX_DROP('idx_faiss_thread_stmt')
1
SELECT VEC_INDEX_DROP('idx_faiss_thread_global');
VEC_INDEX_DROP('idx_faiss_thread_global')
1
SELECT VEC_INDEX_DROP('idx_faiss_thread_zero');
VEC_INDEX_DROP('idx_faiss_thread_zero')
1
SET GLOBAL vector_faiss_build_threads=DEFAULT;
