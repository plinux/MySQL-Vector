#
# WL#vector-v1: configure FAISS build worker count
#
SET GLOBAL vector_faiss_build_threads=2;
SELECT @@global.vector_faiss_build_threads;
@@global.vector_faiss_build_threads
2
SELECT VEC_INDEX_CREATE('idx_faiss_thread_global', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS');
VEC_INDEX_CREATE('idx_faiss_thread_global', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS')
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_thread_global'),
'$.faiss_build_threads') AS inherited_threads;
inherited_threads
2
SELECT VEC_INDEX_CREATE('idx_faiss_thread_stmt', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS', 3);
VEC_INDEX_CREATE('idx_faiss_thread_stmt', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS', 3)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_thread_stmt'),
'$.faiss_build_threads') AS statement_threads;
statement_threads
3
SELECT VEC_INDEX_CREATE('idx_faiss_thread_zero', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS', 0);
VEC_INDEX_CREATE('idx_faiss_thread_zero', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS', 0)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_thread_zero'),
'$.faiss_build_threads') AS statement_zero_threads;
statement_zero_threads
2
SELECT VEC_INDEX_BULK_LOAD_BEGIN('idx_faiss_thread_stmt');
VEC_INDEX_BULK_LOAD_BEGIN('idx_faiss_thread_stmt')
1
SET @faiss_thread_txn = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_faiss_thread_stmt', @faiss_thread_txn, 1,
'[1,0]');
VEC_INDEX_STAGE_UPSERT('idx_faiss_thread_stmt', @faiss_thread_txn, 1,
'[1,0]')
1
SELECT VEC_INDEX_STAGE_UPSERT('idx_faiss_thread_stmt', @faiss_thread_txn, 2,
'[2,0]');
VEC_INDEX_STAGE_UPSERT('idx_faiss_thread_stmt', @faiss_thread_txn, 2,
'[2,0]')
1
SELECT VEC_INDEX_TXN_COMMIT(@faiss_thread_txn);
VEC_INDEX_TXN_COMMIT(@faiss_thread_txn)
1
SELECT VEC_INDEX_BULK_BUILD('idx_faiss_thread_stmt');
VEC_INDEX_BULK_BUILD('idx_faiss_thread_stmt')
1
SELECT VEC_INDEX_SEARCH('idx_faiss_thread_stmt', '[2,0]', 1);
VEC_INDEX_SEARCH('idx_faiss_thread_stmt', '[2,0]', 1)
[2]
DROP TABLE IF EXISTS t_faiss_thread_ddl;
CREATE TABLE t_faiss_thread_ddl(id INT PRIMARY KEY, v VECTOR(2));
INSERT INTO t_faiss_thread_ddl VALUES (1, VEC_FROMTEXT('[1,1]'));
CREATE VECTOR INDEX ON t_faiss_thread_ddl(v)
WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS', 4);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('test.t_faiss_thread_ddl.v'),
'$.faiss_build_threads') AS ddl_threads;
ddl_threads
4
SHOW VECTOR STATUS FOR INDEX 'test.t_faiss_thread_ddl.v'
WHERE Variable_name = 'test.t_faiss_thread_ddl.v.faiss_build_threads';
Section	Variable_name	Value
INDEX_STATE	test.t_faiss_thread_ddl.v.faiss_build_threads	4
SHOW CREATE TABLE t_faiss_thread_ddl;
Table	Create Table
t_faiss_thread_ddl	CREATE TABLE `t_faiss_thread_ddl` (
  `id` int NOT NULL,
  `v` vector(2),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
CREATE VECTOR INDEX ON `t_faiss_thread_ddl`(`v`) WITH (2, 'euclidean', 'external', 'faiss', 4)
SELECT VEC_INDEX_CREATE('idx_faiss_thread_bad', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS', 65536);
