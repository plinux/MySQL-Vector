#
# Variable name : vector_diskann_build_threads, vector_diskann_build_mode
# Persistence   : SET PERSIST / RESET PERSIST
#
# DiskANN build-thread variable is registered.
SELECT VARIABLE_NAME
FROM performance_schema.global_variables
WHERE VARIABLE_NAME IN ('vector_diskann_build_threads',
'vector_diskann_build_mode')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME
vector_diskann_build_mode
vector_diskann_build_threads
include/assert.inc [Expect vector_diskann_build_threads to be registered.]
include/assert.inc [Expect vector_diskann_build_mode to be registered.]
include/assert.inc [Expect DiskANN build variables not to be persisted before SET PERSIST.]
# Persist DiskANN build variables.
SET PERSIST vector_diskann_build_threads=3;
SET PERSIST vector_diskann_build_mode='offline';
include/assert.inc [Expect DiskANN build variables to be persisted before restart.]
SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.persisted_variables
WHERE VARIABLE_NAME IN ('vector_diskann_build_threads',
'vector_diskann_build_mode')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
vector_diskann_build_mode	offline
vector_diskann_build_threads	3
# Restart and verify DiskANN build variables survive.
# restart
include/assert.inc [Expect DiskANN build variables to be persisted after restart.]
SELECT vi.VARIABLE_NAME, vi.VARIABLE_SOURCE, pv.VARIABLE_VALUE, gv.VARIABLE_VALUE
FROM performance_schema.variables_info vi
JOIN performance_schema.persisted_variables pv
ON vi.VARIABLE_NAME=pv.VARIABLE_NAME
JOIN performance_schema.global_variables gv
ON vi.VARIABLE_NAME=gv.VARIABLE_NAME
WHERE vi.VARIABLE_NAME IN ('vector_diskann_build_threads',
'vector_diskann_build_mode')
ORDER BY vi.VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_SOURCE	VARIABLE_VALUE	VARIABLE_VALUE
vector_diskann_build_mode	PERSISTED	offline	offline
vector_diskann_build_threads	PERSISTED	3	3
# Reset persisted DiskANN build variables.
RESET PERSIST IF EXISTS vector_diskann_build_threads;
RESET PERSIST IF EXISTS vector_diskann_build_mode;
include/assert.inc [Expect DiskANN build variable persistence to be reset.]
# restart
