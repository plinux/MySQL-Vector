VARIABLE_NAME	VARIABLE_VALUE
vector_build_resource_wait_timeout	30
RESET PERSIST IF EXISTS vector_build_resource_wait_timeout;
# Zero restores interruptible infinite waiting; unsigned values follow
# normal MySQL clipping semantics.
