# Global defaults.
SELECT @@global.vector_build_pipeline_mode,
@@global.vector_build_pipeline_min_rows,
@@global.vector_build_pipeline_min_size,
@@global.vector_build_segment_max_rows,
@@global.vector_build_segment_target_size,
@@global.vector_build_pipeline_max_tasks,
@@global.vector_build_pipeline_progress_interval;
@@global.vector_build_pipeline_mode	@@global.vector_build_pipeline_min_rows	@@global.vector_build_pipeline_min_size	@@global.vector_build_segment_max_rows	@@global.vector_build_segment_target_size	@@global.vector_build_pipeline_max_tasks	@@global.vector_build_pipeline_progress_interval
auto	1048576	4294967296	1048576	8589934592	1	10
SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME IN ('vector_build_pipeline_mode',
'vector_build_pipeline_min_rows',
'vector_build_pipeline_min_size',
'vector_build_segment_max_rows',
'vector_build_segment_target_size',
'vector_build_pipeline_max_tasks',
'vector_build_pipeline_progress_interval')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
vector_build_pipeline_max_tasks	1
vector_build_pipeline_min_rows	1048576
vector_build_pipeline_min_size	4294967296
vector_build_pipeline_mode	auto
vector_build_pipeline_progress_interval	10
vector_build_segment_max_rows	1048576
vector_build_segment_target_size	8589934592
SELECT @@session.vector_build_pipeline_mode;
ERROR HY000: Variable 'vector_build_pipeline_mode' is a GLOBAL variable
# Runtime changes are allowed.
SET GLOBAL vector_build_pipeline_mode='direct';
SET GLOBAL vector_build_pipeline_min_rows=0;
SET GLOBAL vector_build_pipeline_min_size=0;
SET GLOBAL vector_build_segment_max_rows=1;
SET GLOBAL vector_build_segment_target_size=1048576;
SET GLOBAL vector_build_pipeline_max_tasks=1;
SET GLOBAL vector_build_pipeline_progress_interval=1;
SELECT @@global.vector_build_pipeline_mode,
