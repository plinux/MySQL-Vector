# Persist and reset.
SET PERSIST vector_build_pipeline_mode='direct';
SET PERSIST vector_build_pipeline_min_rows=1024;
SET PERSIST vector_build_pipeline_min_size=2097152;
SET PERSIST vector_build_segment_max_rows=2048;
SET PERSIST vector_build_segment_target_size=3145728;
SET PERSIST vector_build_pipeline_max_tasks=2;
SET PERSIST vector_build_pipeline_progress_interval=30;
SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.persisted_variables
WHERE VARIABLE_NAME IN ('vector_build_pipeline_mode',
'vector_build_pipeline_min_rows',
'vector_build_pipeline_min_size',
'vector_build_segment_max_rows',
'vector_build_segment_target_size',
'vector_build_pipeline_max_tasks',
'vector_build_pipeline_progress_interval')
ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
vector_build_pipeline_max_tasks	2
vector_build_pipeline_min_rows	1024
vector_build_pipeline_min_size	2097152
vector_build_pipeline_mode	direct
vector_build_pipeline_progress_interval	30
vector_build_segment_max_rows	2048
vector_build_segment_target_size	3145728
RESET PERSIST IF EXISTS vector_build_pipeline_mode;
RESET PERSIST IF EXISTS vector_build_pipeline_min_rows;
RESET PERSIST IF EXISTS vector_build_pipeline_min_size;
RESET PERSIST IF EXISTS vector_build_segment_max_rows;
RESET PERSIST IF EXISTS vector_build_segment_target_size;
RESET PERSIST IF EXISTS vector_build_pipeline_max_tasks;
RESET PERSIST IF EXISTS vector_build_pipeline_progress_interval;
SET GLOBAL vector_build_pipeline_mode=DEFAULT;
