direct	0	0	1	1048576	1	1
SET GLOBAL vector_build_pipeline_mode='segmented';
SET GLOBAL vector_build_pipeline_min_rows=18446744073709551615;
SET GLOBAL vector_build_pipeline_min_size=1048576;
