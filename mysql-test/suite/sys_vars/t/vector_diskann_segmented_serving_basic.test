--source include/have_vector_index.inc

--echo #
--echo # Variable name : vector_diskann_segmented_serving
--echo # Scope         : Global dynamic
--echo #

--echo # Global - default
SELECT @@global.vector_diskann_segmented_serving;

--echo # Visible through SHOW VARIABLES and performance_schema.
SHOW GLOBAL VARIABLES LIKE 'vector_diskann_segmented_serving';
SHOW SESSION VARIABLES LIKE 'vector_diskann_segmented_serving';
SELECT * FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='vector_diskann_segmented_serving';
SELECT * FROM performance_schema.session_variables
  WHERE VARIABLE_NAME='vector_diskann_segmented_serving';

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.vector_diskann_segmented_serving;

--Error ER_BAD_FIELD_ERROR
SELECT vector_diskann_segmented_serving;

--echo # Runtime changes are allowed.
SET GLOBAL vector_diskann_segmented_serving=ON;
SELECT @@global.vector_diskann_segmented_serving;

SET GLOBAL vector_diskann_segmented_serving=OFF;
SELECT @@global.vector_diskann_segmented_serving;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_segmented_serving=2;

SET GLOBAL vector_diskann_segmented_serving=DEFAULT;
SELECT @@global.vector_diskann_segmented_serving;

--echo # End of tests.
