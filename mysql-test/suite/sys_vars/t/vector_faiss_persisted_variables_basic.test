--echo #
--echo # Variable name : vector_faiss_build_threads
--echo # Persistence   : SET PERSIST / RESET PERSIST
--echo #

--source suite/sys_vars/include/vector_persisted_variables_preamble.inc

--echo # Faiss build-thread variable is registered.
SELECT VARIABLE_NAME
FROM performance_schema.global_variables
WHERE VARIABLE_NAME = 'vector_faiss_build_threads';

--let $assert_text= Expect vector_faiss_build_threads to be registered.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.global_variables WHERE VARIABLE_NAME = 'vector_faiss_build_threads', count, 1] = 1
--source include/assert.inc

--let $assert_text= Expect vector_faiss_build_threads not to be persisted before SET PERSIST.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_faiss_build_threads', count, 1] = 0
--source include/assert.inc

--echo # Persist vector_faiss_build_threads.
SET PERSIST vector_faiss_build_threads=2;

--let $assert_text= Expect vector_faiss_build_threads to be persisted before restart.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_faiss_build_threads', count, 1] = 1
--source include/assert.inc

SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.persisted_variables
WHERE VARIABLE_NAME = 'vector_faiss_build_threads';

--echo # Restart and verify vector_faiss_build_threads survives.
--source suite/sys_vars/include/vector_persisted_variables_restart.inc

--let $assert_text= Expect vector_faiss_build_threads to be persisted after restart.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_faiss_build_threads', count, 1] = 1
--source include/assert.inc

SELECT vi.VARIABLE_NAME, vi.VARIABLE_SOURCE, pv.VARIABLE_VALUE, gv.VARIABLE_VALUE
FROM performance_schema.variables_info vi
JOIN performance_schema.persisted_variables pv
  ON vi.VARIABLE_NAME=pv.VARIABLE_NAME
JOIN performance_schema.global_variables gv
  ON vi.VARIABLE_NAME=gv.VARIABLE_NAME
WHERE vi.VARIABLE_NAME = 'vector_faiss_build_threads';

--echo # Reset persisted vector_faiss_build_threads.
RESET PERSIST IF EXISTS vector_faiss_build_threads;

--let $assert_text= Expect vector_faiss_build_threads persistence to be reset.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_faiss_build_threads', count, 1] = 0
--source include/assert.inc

--source suite/sys_vars/include/vector_persisted_variables_cleanup.inc
