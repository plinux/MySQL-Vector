--echo #
--echo # Variable name : innodb_vector_upgrade_require_clean_shutdown
--echo # Scope         : Global read only, non-persistent
--echo #

--source include/have_vector_index.inc

--echo # Global - default
SELECT @@global.innodb_vector_upgrade_require_clean_shutdown;

--echo # Visible through SHOW VARIABLES and performance_schema.
SHOW GLOBAL VARIABLES LIKE 'innodb_vector_upgrade_require_clean_shutdown';
SHOW SESSION VARIABLES LIKE 'innodb_vector_upgrade_require_clean_shutdown';
SELECT * FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='innodb_vector_upgrade_require_clean_shutdown';
SELECT * FROM performance_schema.session_variables
  WHERE VARIABLE_NAME='innodb_vector_upgrade_require_clean_shutdown';

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.innodb_vector_upgrade_require_clean_shutdown;

--Error ER_BAD_FIELD_ERROR
SELECT innodb_vector_upgrade_require_clean_shutdown;

--echo # Runtime and persisted changes are not allowed.
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL innodb_vector_upgrade_require_clean_shutdown=ON;

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET PERSIST innodb_vector_upgrade_require_clean_shutdown=ON;

--echo # End of tests.
