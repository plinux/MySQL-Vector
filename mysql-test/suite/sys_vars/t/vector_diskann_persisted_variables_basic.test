--echo #
--echo # Variable name : vector_diskann_build_threads, vector_diskann_build_mode
--echo # Persistence   : SET PERSIST / RESET PERSIST
--echo #

--source include/have_vector_index.inc
--source include/have_debug.inc
--source include/not_windows.inc
--source include/have_binlog_format_row.inc

--let $MYSQLD_DATADIR= `select @@datadir;`
--let $assert_escape= 1

--echo # DiskANN build-thread variable is registered.
SELECT VARIABLE_NAME
FROM performance_schema.global_variables
WHERE VARIABLE_NAME IN ('vector_diskann_build_threads',
                        'vector_diskann_build_mode')
ORDER BY VARIABLE_NAME;

--let $assert_text= Expect vector_diskann_build_threads to be registered.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.global_variables WHERE VARIABLE_NAME = 'vector_diskann_build_threads', count, 1] = 1
--source include/assert.inc
--let $assert_text= Expect vector_diskann_build_mode to be registered.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.global_variables WHERE VARIABLE_NAME = 'vector_diskann_build_mode', count, 1] = 1
--source include/assert.inc

--let $assert_text= Expect DiskANN build variables not to be persisted before SET PERSIST.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_diskann_build_threads' OR VARIABLE_NAME = 'vector_diskann_build_mode', count, 1] = 0
--source include/assert.inc

--echo # Persist DiskANN build variables.
SET PERSIST vector_diskann_build_threads=3;
SET PERSIST vector_diskann_build_mode='offline';

--let $assert_text= Expect DiskANN build variables to be persisted before restart.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_diskann_build_threads' OR VARIABLE_NAME = 'vector_diskann_build_mode', count, 1] = 2
--source include/assert.inc

SELECT VARIABLE_NAME, VARIABLE_VALUE
FROM performance_schema.persisted_variables
WHERE VARIABLE_NAME IN ('vector_diskann_build_threads',
                        'vector_diskann_build_mode')
ORDER BY VARIABLE_NAME;

--echo # Restart and verify DiskANN build variables survive.
--source include/restart_mysqld.inc
--source include/wait_until_connected_again.inc

--let $assert_text= Expect DiskANN build variables to be persisted after restart.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_diskann_build_threads' OR VARIABLE_NAME = 'vector_diskann_build_mode', count, 1] = 2
--source include/assert.inc

SELECT vi.VARIABLE_NAME, vi.VARIABLE_SOURCE, pv.VARIABLE_VALUE, gv.VARIABLE_VALUE
FROM performance_schema.variables_info vi
JOIN performance_schema.persisted_variables pv
  ON vi.VARIABLE_NAME=pv.VARIABLE_NAME
JOIN performance_schema.global_variables gv
  ON vi.VARIABLE_NAME=gv.VARIABLE_NAME
WHERE vi.VARIABLE_NAME IN ('vector_diskann_build_threads',
                           'vector_diskann_build_mode')
ORDER BY vi.VARIABLE_NAME;

--echo # Reset persisted DiskANN build variables.
RESET PERSIST IF EXISTS vector_diskann_build_threads;
RESET PERSIST IF EXISTS vector_diskann_build_mode;

--let $assert_text= Expect DiskANN build variable persistence to be reset.
--let $assert_cond= [SELECT COUNT(*) AS count FROM performance_schema.persisted_variables WHERE VARIABLE_NAME = 'vector_diskann_build_threads' OR VARIABLE_NAME = 'vector_diskann_build_mode', count, 1] = 0
--source include/assert.inc

--remove_file $MYSQLD_DATADIR/mysqld-auto.cnf
--source include/restart_mysqld.inc
