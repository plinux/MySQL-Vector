--echo #
--echo # Variable name : vector_faiss_build_threads
--echo # Scope         : Global dynamic
--echo #

--source include/have_vector_index.inc

--echo # Global - default
SELECT @@global.vector_faiss_build_threads;

--echo # Visible through SHOW VARIABLES and performance_schema.
SHOW GLOBAL VARIABLES LIKE 'vector_faiss_build_threads';
SHOW SESSION VARIABLES LIKE 'vector_faiss_build_threads';
SELECT * FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='vector_faiss_build_threads';
SELECT * FROM performance_schema.session_variables
  WHERE VARIABLE_NAME='vector_faiss_build_threads';

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.vector_faiss_build_threads;

--Error ER_BAD_FIELD_ERROR
SELECT vector_faiss_build_threads;

--echo # Runtime changes are allowed.
SET GLOBAL vector_faiss_build_threads=4;
SELECT @@global.vector_faiss_build_threads;

SET GLOBAL vector_faiss_build_threads=65535;
SELECT @@global.vector_faiss_build_threads;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_faiss_build_threads=65536;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_faiss_build_threads=-1;

SET GLOBAL vector_faiss_build_threads=DEFAULT;
SELECT @@global.vector_faiss_build_threads;

--echo # End of tests.
