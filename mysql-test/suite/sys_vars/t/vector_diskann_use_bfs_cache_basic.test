--source include/have_vector_index.inc

--echo #
--echo # Variable name : vector_diskann_use_bfs_cache
--echo # Scope         : Global dynamic
--echo #

--echo # Global - default
SELECT @@global.vector_diskann_use_bfs_cache;

--echo # Visible through SHOW VARIABLES and performance_schema.
SHOW GLOBAL VARIABLES LIKE 'vector_diskann_use_bfs_cache';
SHOW SESSION VARIABLES LIKE 'vector_diskann_use_bfs_cache';
SELECT * FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='vector_diskann_use_bfs_cache';
SELECT * FROM performance_schema.session_variables
  WHERE VARIABLE_NAME='vector_diskann_use_bfs_cache';

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.vector_diskann_use_bfs_cache;

--Error ER_BAD_FIELD_ERROR
SELECT vector_diskann_use_bfs_cache;

--echo # Runtime changes are allowed.
SET GLOBAL vector_diskann_use_bfs_cache=ON;
SELECT @@global.vector_diskann_use_bfs_cache;

SET GLOBAL vector_diskann_use_bfs_cache=OFF;
SELECT @@global.vector_diskann_use_bfs_cache;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_use_bfs_cache=2;

SET GLOBAL vector_diskann_use_bfs_cache=DEFAULT;
SELECT @@global.vector_diskann_use_bfs_cache;

--echo # End of tests.
