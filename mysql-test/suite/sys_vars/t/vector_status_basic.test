  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_pending_txn_changes');
SET @manifest_version_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_version');
SET @manifest_meta_ckpt_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_metadata_checkpoint');
SET @manifest_committed_ckpt_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_committed_checkpoint');
SET @manifest_change_log_ckpt_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');

SELECT VEC_INDEX_CREATE('idx_status', 2);
SELECT VEC_INDEX_UPSERT('idx_status', 1, '[1,2]');

SET @txn1 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_status', @txn1, 2, '[2,2]');
SELECT VEC_INDEX_STAGE_ERASE('idx_status', @txn1, 1);
SELECT VEC_INDEX_TXN_PENDING(@txn1);
SELECT VEC_INDEX_TXN_ROLLBACK(@txn1);

SELECT VEC_INDEX_SEARCH('idx_status', '[1,2]', 1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('idx_missing_status', '[1,2]', 1);

SELECT VEC_INDEX_REBUILD('idx_status');
SELECT VEC_INDEX_RECOVER('idx_status');
SELECT VEC_INDEX_REBUILD_ALL();
SELECT VEC_INDEX_RECOVER_ALL();

SELECT VEC_INDEX_CREATE('idx_ext_status', 2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS');
SET @txn2 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_ext_status', @txn2, 9, '[9,9]');
SELECT VEC_INDEX_TXN_COMMIT(@txn2);
SELECT VEC_INDEX_TXN_ROLLBACK(@txn2);

SELECT VEC_INDEX_DROP('idx_status');
SELECT VEC_INDEX_DROP('idx_ext_status');

SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_index_create_requests') - @create_req_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_index_drop_requests') - @drop_req_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_metadata_load_failures') - @metadata_load_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_metadata_persist_failures') - @metadata_persist_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_load_failures') - @manifest_load_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_persist_failures') - @manifest_persist_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_change_log_load_failures') - @change_log_load_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
