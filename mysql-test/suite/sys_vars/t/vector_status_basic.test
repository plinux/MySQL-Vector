  WHERE VARIABLE_NAME = 'Vector_search_mvcc_limit_hits') - @search_mvcc_limit_hits_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_stage_upsert_requests') - @stage_upsert_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_stage_erase_requests') - @stage_erase_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_txn_commit_requests') - @commit_req_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_txn_commit_failures') - @commit_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_txn_rollback_requests') - @rollback_req_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_runtime_state_rollbacks') >= @runtime_rollback_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_runtime_state_rollback_failures') >= @runtime_rollback_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollbacks') >= @artifact_rollback_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollback_failures') >= @artifact_rollback_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_requests') > @truth_store_persist_req_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_failures') >= @truth_store_persist_fail_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_pending_txn_changes') - @pending_before;
SELECT (
  SELECT COUNT(*)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_apply_latency_ms');
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_apply_latency_ms') > 0;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_version') > @manifest_version_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
