SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_search_results_returned') - @search_result_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
