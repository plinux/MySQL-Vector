  WHERE VARIABLE_NAME = 'Vector_registered_indexes') - @registered_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_rebuild_requests') - @rebuild_before;
SELECT (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
