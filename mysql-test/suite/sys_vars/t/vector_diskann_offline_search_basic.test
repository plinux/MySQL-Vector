--echo #
--echo # Variable name : vector_diskann_* offline search params
--echo # Scope         : Global dynamic
--echo #

--source include/have_vector_index.inc

--echo # Global defaults.
SELECT @@global.vector_diskann_offline_search_threads,
       @@global.vector_diskann_search_io_limit,
       @@global.vector_diskann_cache_nodes,
       @@global.vector_diskann_search_complexity,
       @@global.vector_diskann_search_beamwidth,
       @@global.vector_diskann_exact_rerank_candidates,
       @@global.vector_diskann_pq_code_budget_size,
       @@global.vector_diskann_pq_code_budget_ratio,
       @@global.vector_diskann_search_cache_size,
       @@global.vector_diskann_search_cache_ratio;

SELECT VARIABLE_NAME, VARIABLE_VALUE
  FROM performance_schema.global_variables
  WHERE VARIABLE_NAME IN ('vector_diskann_offline_search_threads',
                          'vector_diskann_search_io_limit',
                          'vector_diskann_cache_nodes',
                          'vector_diskann_search_complexity',
                          'vector_diskann_search_beamwidth',
                          'vector_diskann_exact_rerank_candidates',
                          'vector_diskann_pq_code_budget_size',
                          'vector_diskann_pq_code_budget_ratio',
                          'vector_diskann_search_cache_size',
                          'vector_diskann_search_cache_ratio')
  ORDER BY VARIABLE_NAME;

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.vector_diskann_search_io_limit;

--echo # Runtime changes are allowed.
SET GLOBAL vector_diskann_offline_search_threads=8;
SET GLOBAL vector_diskann_search_io_limit=1024;
SET GLOBAL vector_diskann_cache_nodes=2048;
SET GLOBAL vector_diskann_search_complexity=96;
SET GLOBAL vector_diskann_search_beamwidth=16;
SET GLOBAL vector_diskann_exact_rerank_candidates=8192;
SET GLOBAL vector_diskann_pq_code_budget_size=1048576;
SET GLOBAL vector_diskann_pq_code_budget_ratio=0.25;
SET GLOBAL vector_diskann_search_cache_size=2097152;
SET GLOBAL vector_diskann_search_cache_ratio=0.2;
SELECT @@global.vector_diskann_offline_search_threads,
       @@global.vector_diskann_search_io_limit,
       @@global.vector_diskann_cache_nodes,
       @@global.vector_diskann_search_complexity,
       @@global.vector_diskann_search_beamwidth,
       @@global.vector_diskann_exact_rerank_candidates,
       @@global.vector_diskann_pq_code_budget_size,
       @@global.vector_diskann_pq_code_budget_ratio,
       @@global.vector_diskann_search_cache_size,
       @@global.vector_diskann_search_cache_ratio;

SET GLOBAL vector_diskann_offline_search_threads=65535;
SET GLOBAL vector_diskann_search_io_limit=4294967295;
SET GLOBAL vector_diskann_cache_nodes=4294967295;
SET GLOBAL vector_diskann_search_complexity=4294967295;
SET GLOBAL vector_diskann_search_beamwidth=128;
SET GLOBAL vector_diskann_exact_rerank_candidates=1048576;
SET GLOBAL vector_diskann_pq_code_budget_size=0;
SET GLOBAL vector_diskann_pq_code_budget_ratio=1;
SET GLOBAL vector_diskann_search_cache_size=0;
SET GLOBAL vector_diskann_search_cache_ratio=1;
SELECT @@global.vector_diskann_offline_search_threads,
       @@global.vector_diskann_search_io_limit,
       @@global.vector_diskann_cache_nodes,
       @@global.vector_diskann_search_complexity,
       @@global.vector_diskann_search_beamwidth,
       @@global.vector_diskann_exact_rerank_candidates,
       @@global.vector_diskann_pq_code_budget_size,
       @@global.vector_diskann_pq_code_budget_ratio,
       @@global.vector_diskann_search_cache_size,
       @@global.vector_diskann_search_cache_ratio;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_offline_search_threads=65536;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_io_limit=4294967296;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_cache_nodes=4294967296;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_complexity=0;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_complexity=4294967296;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_beamwidth=129;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_exact_rerank_candidates=1048577;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_io_limit=-1;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_pq_code_budget_size=-1;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_pq_code_budget_ratio=1.1;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_cache_size=-1;
--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_search_cache_ratio=1.1;

--echo # Persist and reset.
SET PERSIST vector_diskann_offline_search_threads=8;
SET PERSIST vector_diskann_search_io_limit=1024;
SET PERSIST vector_diskann_cache_nodes=2048;
SET PERSIST vector_diskann_search_complexity=96;
SET PERSIST vector_diskann_search_beamwidth=16;
SET PERSIST vector_diskann_exact_rerank_candidates=8192;
SET PERSIST vector_diskann_pq_code_budget_size=1048576;
SET PERSIST vector_diskann_pq_code_budget_ratio=0.25;
SET PERSIST vector_diskann_search_cache_size=2097152;
SET PERSIST vector_diskann_search_cache_ratio=0.2;
SELECT VARIABLE_NAME, VARIABLE_VALUE
  FROM performance_schema.persisted_variables
  WHERE VARIABLE_NAME IN ('vector_diskann_offline_search_threads',
                          'vector_diskann_search_io_limit',
                          'vector_diskann_cache_nodes',
                          'vector_diskann_search_complexity',
                          'vector_diskann_search_beamwidth',
                          'vector_diskann_exact_rerank_candidates',
                          'vector_diskann_pq_code_budget_size',
                          'vector_diskann_pq_code_budget_ratio',
                          'vector_diskann_search_cache_size',
                          'vector_diskann_search_cache_ratio')
  ORDER BY VARIABLE_NAME;

RESET PERSIST IF EXISTS vector_diskann_offline_search_threads;
RESET PERSIST IF EXISTS vector_diskann_search_io_limit;
RESET PERSIST IF EXISTS vector_diskann_cache_nodes;
RESET PERSIST IF EXISTS vector_diskann_search_complexity;
RESET PERSIST IF EXISTS vector_diskann_search_beamwidth;
RESET PERSIST IF EXISTS vector_diskann_exact_rerank_candidates;
RESET PERSIST IF EXISTS vector_diskann_pq_code_budget_size;
RESET PERSIST IF EXISTS vector_diskann_pq_code_budget_ratio;
RESET PERSIST IF EXISTS vector_diskann_search_cache_size;
RESET PERSIST IF EXISTS vector_diskann_search_cache_ratio;
SET GLOBAL vector_diskann_offline_search_threads=DEFAULT;
SET GLOBAL vector_diskann_search_io_limit=DEFAULT;
SET GLOBAL vector_diskann_cache_nodes=DEFAULT;
SET GLOBAL vector_diskann_search_complexity=DEFAULT;
SET GLOBAL vector_diskann_search_beamwidth=DEFAULT;
SET GLOBAL vector_diskann_exact_rerank_candidates=DEFAULT;
SET GLOBAL vector_diskann_pq_code_budget_size=DEFAULT;
SET GLOBAL vector_diskann_pq_code_budget_ratio=DEFAULT;
SET GLOBAL vector_diskann_search_cache_size=DEFAULT;
SET GLOBAL vector_diskann_search_cache_ratio=DEFAULT;
SELECT @@global.vector_diskann_offline_search_threads,
       @@global.vector_diskann_search_io_limit,
       @@global.vector_diskann_cache_nodes,
       @@global.vector_diskann_search_complexity,
       @@global.vector_diskann_search_beamwidth,
       @@global.vector_diskann_exact_rerank_candidates,
       @@global.vector_diskann_pq_code_budget_size,
       @@global.vector_diskann_pq_code_budget_ratio,
       @@global.vector_diskann_search_cache_size,
       @@global.vector_diskann_search_cache_ratio;

--echo # End of tests.
