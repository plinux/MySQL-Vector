--source include/have_vector_index.inc

--echo #
--echo # Variable name : vector_diskann_disk_pq_dims
--echo # Scope         : Global dynamic
--echo #

--echo # Global - default
SELECT @@global.vector_diskann_disk_pq_dims;

--echo # Visible through SHOW VARIABLES and performance_schema.
SHOW GLOBAL VARIABLES LIKE 'vector_diskann_disk_pq_dims';
SHOW SESSION VARIABLES LIKE 'vector_diskann_disk_pq_dims';
SELECT * FROM performance_schema.global_variables
  WHERE VARIABLE_NAME='vector_diskann_disk_pq_dims';
SELECT * FROM performance_schema.session_variables
  WHERE VARIABLE_NAME='vector_diskann_disk_pq_dims';

--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.vector_diskann_disk_pq_dims;

--Error ER_BAD_FIELD_ERROR
SELECT vector_diskann_disk_pq_dims;

--echo # Runtime changes are allowed.
SET GLOBAL vector_diskann_disk_pq_dims=12;
SELECT @@global.vector_diskann_disk_pq_dims;

SET GLOBAL vector_diskann_disk_pq_dims=65535;
SELECT @@global.vector_diskann_disk_pq_dims;

SET GLOBAL vector_diskann_disk_pq_dims=0;
SELECT @@global.vector_diskann_disk_pq_dims;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_disk_pq_dims=65536;

--Error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL vector_diskann_disk_pq_dims=-1;

SET GLOBAL vector_diskann_disk_pq_dims=DEFAULT;
SELECT @@global.vector_diskann_disk_pq_dims;

--echo # End of tests.
