#
# WL#vector-v1: lifecycle persist failure rolls back runtime serving state
#
SELECT VEC_INDEX_CREATE('idx_lifecycle_pf', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_lifecycle_pf', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_UPSERT('idx_lifecycle_pf', 1, VEC_FROMTEXT('[1,1]'));
VEC_INDEX_UPSERT('idx_lifecycle_pf', 1, VEC_FROMTEXT('[1,1]'))
1
SELECT VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1)
[1]
# persist failure during REBUILD should keep pre-rebuild serving state
SELECT VEC_INDEX_REBUILD('idx_lifecycle_pf');
ERROR HY000: Incorrect arguments to vec_index_rebuild
SELECT VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1)
[1]
# successful REBUILD preserves committed serving state
SELECT VEC_INDEX_REBUILD('idx_lifecycle_pf');
VEC_INDEX_REBUILD('idx_lifecycle_pf')
1
SELECT VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1)
[1]
# persist failure during RECOVER should keep rebuilt serving state
SELECT VEC_INDEX_RECOVER('idx_lifecycle_pf');
ERROR HY000: Incorrect arguments to vec_index_recover
SELECT VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1)
[1]
# successful RECOVER restores committed serving state
SELECT VEC_INDEX_RECOVER('idx_lifecycle_pf');
VEC_INDEX_RECOVER('idx_lifecycle_pf')
1
SELECT VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('idx_lifecycle_pf', VEC_FROMTEXT('[1,1]'), 1)
[1]
SELECT VEC_INDEX_DROP('idx_lifecycle_pf');
VEC_INDEX_DROP('idx_lifecycle_pf')
1
