1
SELECT JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[3,3]', 8), CAST(3 AS JSON));
JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[3,3]', 8), CAST(3 AS JSON))
