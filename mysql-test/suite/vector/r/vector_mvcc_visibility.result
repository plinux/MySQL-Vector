1
SELECT JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[2,2]', 8), CAST(2 AS JSON));
JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[2,2]', 8), CAST(2 AS JSON))
0
COMMIT;
