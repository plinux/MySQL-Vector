DROP TABLE IF EXISTS t_vec_mvcc;
Warnings:
Note	1051	Unknown table 'test.t_vec_mvcc'
CREATE TABLE t_vec_mvcc (
id INT PRIMARY KEY,
v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON t_vec_mvcc(v) WITH (2);
SET @mvcc_candidates_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_search_mvcc_candidate_rows');
INSERT INTO t_vec_mvcc VALUES (1, VEC_FROMTEXT('[1,1]'));
SELECT JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[1,1]', 8), CAST(1 AS JSON));
JSON_CONTAINS(
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[1,1]', 8), CAST(1 AS JSON))
1
START TRANSACTION;
INSERT INTO t_vec_mvcc VALUES (2, VEC_FROMTEXT('[2,2]'));
