START TRANSACTION;
UPDATE t_vec_mvcc SET v=VEC_FROMTEXT('[9,9]') WHERE id=1;
SELECT VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1);
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1)
[1]
SELECT VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1);
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1)
[2]
COMMIT;
SELECT VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1);
VEC_INDEX_SEARCH('test.t_vec_mvcc.v', '[9,9]', 1)
[1]
START TRANSACTION;
DELETE FROM t_vec_mvcc WHERE id=1;
