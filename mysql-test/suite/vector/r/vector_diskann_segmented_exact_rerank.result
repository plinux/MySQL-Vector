#
# WL#Vector: DISKANN segmented exact rerank keeps boundary docids
#
SELECT VEC_INDEX_CREATE('idx_diskann_segmented_rerank', 1024, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0, 'standalone');
VEC_INDEX_CREATE('idx_diskann_segmented_rerank', 1024, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0, 'standalone')
1
SELECT VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_segmented_rerank',
'offline');
VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_segmented_rerank',
'offline')
1
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_segmented_rerank',
32, 64, 4);
VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_segmented_rerank',
32, 64, 4)
1
SELECT VEC_INDEX_SET_DISKANN_SEARCH_COMPLEXITY(
'idx_diskann_segmented_rerank', 2048);
VEC_INDEX_SET_DISKANN_SEARCH_COMPLEXITY(
'idx_diskann_segmented_rerank', 2048)
1
SELECT VEC_INDEX_SET_DISKANN_SEARCH_BEAMWIDTH(
'idx_diskann_segmented_rerank', 16);
VEC_INDEX_SET_DISKANN_SEARCH_BEAMWIDTH(
'idx_diskann_segmented_rerank', 16)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.standalone_raw_segment_count') AS raw_segment_count;
raw_segment_count
9
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.backend_variant')) AS backend_variant,
CAST(JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.backend_build_invocations')) AS UNSIGNED) >= 8 AS has_backend_builds,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.native_pq_runtime_official_pq_used') AS used_official_fallback,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.scheduler_single_index_build') AS single_index_build,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.entry_count') AS entry_count;
backend_variant	has_backend_builds	used_official_fallback	single_index_build	entry_count
segmented	1	0	0	8192
SELECT CAST(JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_SEARCH('idx_diskann_segmented_rerank',
VEC_FROMTEXT(CONCAT('[', 1023,
REPEAT(',0', 1023), ']')), 10),
'$[0]')) AS UNSIGNED) = 1023 AS boundary_left_top1,
CAST(JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_SEARCH('idx_diskann_segmented_rerank',
VEC_FROMTEXT(CONCAT('[', 1024,
REPEAT(',0', 1023), ']')), 10),
'$[0]')) AS UNSIGNED) = 1024 AS boundary_right_top1,
CAST(JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_SEARCH('idx_diskann_segmented_rerank',
VEC_FROMTEXT(CONCAT('[', 2047,
REPEAT(',0', 1023), ']')), 10),
'$[0]')) AS UNSIGNED) = 2047 AS second_segment_tail_top1,
CAST(JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_SEARCH('idx_diskann_segmented_rerank',
VEC_FROMTEXT(CONCAT('[', 8191,
REPEAT(',0', 1023), ']')), 10),
'$[0]')) AS UNSIGNED) = 8191 AS tail_segment_top1;
boundary_left_top1	boundary_right_top1	second_segment_tail_top1	tail_segment_top1
1	1	1	1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.scheduler_search_fanout_segments') AS fanout_segments,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.scheduler_search_candidate_count') > 10
AS candidate_window_expanded,
JSON_EXTRACT(VEC_INDEX_INFO('idx_diskann_segmented_rerank'),
'$.scheduler_search_candidate_count') <=
@@GLOBAL.vector_search_batch_result_count AS candidate_budget_applied;
fanout_segments	candidate_window_expanded	candidate_budget_applied
9	1	1
SELECT VEC_INDEX_DROP('idx_diskann_segmented_rerank');
VEC_INDEX_DROP('idx_diskann_segmented_rerank')
1
