SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_state';
Section	Variable_name	Value
INDEX_STATE	idx_persist_ext.lifecycle_state	ready
INDEX_STATE	idx_persist_mem.lifecycle_state	ready
SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_version';
Section	Variable_name	Value
INDEX_STATE	idx_persist_ext.lifecycle_version	1
INDEX_STATE	idx_persist_mem.lifecycle_version	1
SET @change_log_ckpt_after = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SELECT @change_log_ckpt_after > @change_log_ckpt_before;
@change_log_ckpt_after > @change_log_ckpt_before
1
# restart
SELECT VEC_INDEX_LIST();
VEC_INDEX_LIST()
["idx_persist_ext","idx_persist_mem"]
SELECT VEC_INDEX_INFO('idx_persist_mem');
VEC_INDEX_INFO('idx_persist_mem')
