#
# WL#vector-v1: persist vector index metadata across restart
#
SELECT VEC_INDEX_LIST();
VEC_INDEX_LIST()
[]
SET @change_log_ckpt_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SELECT VEC_INDEX_CREATE('idx_persist_mem', 3, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_persist_mem', 3, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_CREATE('idx_persist_ext', 4, 'COSINE', 'EXTERNAL', 'FAISS');
VEC_INDEX_CREATE('idx_persist_ext', 4, 'COSINE', 'EXTERNAL', 'FAISS')
1
SELECT VEC_INDEX_UPSERT('idx_persist_mem', 1, VEC_FROMTEXT('[1,2,3]'));
VEC_INDEX_UPSERT('idx_persist_mem', 1, VEC_FROMTEXT('[1,2,3]'))
1
SELECT VEC_INDEX_UPSERT('idx_persist_ext', 7, VEC_FROMTEXT('[1,0,0,1]'));
VEC_INDEX_UPSERT('idx_persist_ext', 7, VEC_FROMTEXT('[1,0,0,1]'))
1
SELECT VEC_INDEX_LIST();
VEC_INDEX_LIST()
["idx_persist_ext","idx_persist_mem"]
SELECT VEC_INDEX_INFO('idx_persist_mem');
VEC_INDEX_INFO('idx_persist_mem')
