SET @change_log_ckpt_restart = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SELECT @change_log_ckpt_restart > 0;
@change_log_ckpt_restart > 0
1
SELECT VEC_INDEX_DROP('idx_persist_mem');
VEC_INDEX_DROP('idx_persist_mem')
1
SELECT VEC_INDEX_DROP('idx_persist_ext');
