#
# WL#vector-v1: committed entry cache budget and truth-store read-through
#
SET @old_vector_entry_cache_size = @@global.vector_entry_cache_size;
SET GLOBAL vector_entry_cache_size = 0;
SELECT VEC_INDEX_CREATE('idx_entry_cache_budget', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_entry_cache_budget', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SET @txn = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn, 1, '[1,1]');
VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn, 1, '[1,1]')
1
SELECT VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn, 2, '[2,2]');
VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn, 2, '[2,2]')
1
SELECT VEC_INDEX_TXN_COMMIT(@txn);
VEC_INDEX_TXN_COMMIT(@txn)
1
SHOW GLOBAL STATUS LIKE 'Vector_committed_vector_memory_bytes';
Variable_name	Value
Vector_committed_vector_memory_bytes	0
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_entry_cache_budget'),
'$.committed_entry_count') AS committed_entry_count;
committed_entry_count
2
SET @txn2 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn2, 3, '[3,3]');
VEC_INDEX_STAGE_UPSERT('idx_entry_cache_budget', @txn2, 3, '[3,3]')
1
SELECT VEC_INDEX_TXN_COMMIT(@txn2);
VEC_INDEX_TXN_COMMIT(@txn2)
1
SHOW GLOBAL STATUS LIKE 'Vector_committed_vector_memory_bytes';
Variable_name	Value
Vector_committed_vector_memory_bytes	0
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_entry_cache_budget'),
'$.committed_entry_count') AS committed_entry_count;
committed_entry_count
3
SELECT VEC_INDEX_BULK_BUILD('idx_entry_cache_budget');
VEC_INDEX_BULK_BUILD('idx_entry_cache_budget')
1
SHOW GLOBAL STATUS LIKE 'Vector_committed_vector_memory_bytes';
Variable_name	Value
Vector_committed_vector_memory_bytes	0
SELECT VEC_INDEX_SEARCH('idx_entry_cache_budget', '[1,1]', 2);
VEC_INDEX_SEARCH('idx_entry_cache_budget', '[1,1]', 2)
[1,2]
SHOW GLOBAL STATUS LIKE 'Vector_committed_vector_memory_bytes';
Variable_name	Value
Vector_committed_vector_memory_bytes	0
SELECT VEC_INDEX_DROP('idx_entry_cache_budget');
VEC_INDEX_DROP('idx_entry_cache_budget')
1
SET GLOBAL vector_entry_cache_size = @old_vector_entry_cache_size;
