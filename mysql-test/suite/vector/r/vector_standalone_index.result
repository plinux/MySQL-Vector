#
# WL#Vector: standalone vector index consistency mode
#
SET @old_vector_index_consistency_mode = @@global.vector_index_consistency_mode;
SET @old_vector_entry_cache_size = @@global.vector_entry_cache_size;
SELECT VEC_INDEX_CREATE('idx_txn_default', 2);
VEC_INDEX_CREATE('idx_txn_default', 2)
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_txn_default'),
'$.consistency_mode')) AS consistency_mode,
JSON_EXTRACT(VEC_INDEX_INFO('idx_txn_default'),
'$.truth_store_enabled') AS truth_store_enabled,
JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_txn_default'),
'$.build_source')) AS build_source;
consistency_mode	truth_store_enabled	build_source
transactional	1	truth_store
SELECT VEC_INDEX_UPSERT('idx_txn_default', 1, '[1,1]');
VEC_INDEX_UPSERT('idx_txn_default', 1, '[1,1]')
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_txn_default'), '$.entry_count')
AS entry_count,
JSON_EXTRACT(VEC_INDEX_INFO('idx_txn_default'), '$.committed_entry_count')
AS committed_entry_count;
entry_count	committed_entry_count
1	1
SELECT VEC_INDEX_CREATE('idx_standalone_arg', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE', 0, 'standalone');
VEC_INDEX_CREATE('idx_standalone_arg', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE', 0, 'standalone')
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'),
'$.consistency_mode')) AS consistency_mode,
JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'),
'$.truth_store_enabled') AS truth_store_enabled,
JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'),
'$.build_source')) AS build_source;
consistency_mode	truth_store_enabled	build_source
standalone	0	memory
SELECT VEC_INDEX_UPSERT('idx_standalone_arg', 10, '[1,0]');
VEC_INDEX_UPSERT('idx_standalone_arg', 10, '[1,0]')
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'), '$.entry_count')
AS entry_count,
JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'), '$.committed_entry_count')
AS committed_entry_count,
JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_arg'),
'$.lifecycle_state')) AS lifecycle_state;
entry_count	committed_entry_count	lifecycle_state
0	0	bulk_loading
SELECT VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1);
ERROR HY000: Incorrect arguments to vec_index_search
SELECT VEC_INDEX_REBUILD('idx_standalone_arg');
VEC_INDEX_REBUILD('idx_standalone_arg')
1
SELECT VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1);
VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1)
[10]
SELECT VEC_INDEX_ERASE('idx_standalone_arg', 10);
VEC_INDEX_ERASE('idx_standalone_arg', 10)
1
SELECT VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1);
ERROR HY000: Incorrect arguments to vec_index_search
SELECT VEC_INDEX_REBUILD('idx_standalone_arg');
VEC_INDEX_REBUILD('idx_standalone_arg')
1
SELECT VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1);
VEC_INDEX_SEARCH('idx_standalone_arg', '[1,0]', 1)
[]
SET GLOBAL vector_entry_cache_size = 0;
SELECT VEC_INDEX_CREATE('idx_standalone_spill', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE', 0, 'standalone');
VEC_INDEX_CREATE('idx_standalone_spill', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE', 0, 'standalone')
1
SELECT VEC_INDEX_UPSERT('idx_standalone_spill', 20, '[1,0]');
VEC_INDEX_UPSERT('idx_standalone_spill', 20, '[1,0]')
1
SELECT VEC_INDEX_UPSERT('idx_standalone_spill', 21, '[0,1]');
VEC_INDEX_UPSERT('idx_standalone_spill', 21, '[0,1]')
1
SELECT VEC_INDEX_ERASE('idx_standalone_spill', 20);
VEC_INDEX_ERASE('idx_standalone_spill', 20)
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_spill'),
'$.standalone_ingest_memory_bytes') AS ingest_memory_bytes,
JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_spill'),
'$.standalone_segment_count') > 0 AS has_segments,
JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_spill'),
'$.standalone_segment_bytes') > 0 AS has_segment_bytes,
JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_spill'),
'$.build_source')) AS build_source;
ingest_memory_bytes	has_segments	has_segment_bytes	build_source
0	1	1	delta_replay
SELECT VEC_INDEX_REBUILD('idx_standalone_spill');
VEC_INDEX_REBUILD('idx_standalone_spill')
1
SELECT VEC_INDEX_SEARCH('idx_standalone_spill', '[0,1]', 2);
VEC_INDEX_SEARCH('idx_standalone_spill', '[0,1]', 2)
[21]
SET GLOBAL vector_index_consistency_mode='standalone';
SELECT VEC_INDEX_CREATE('idx_standalone_global', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE');
VEC_INDEX_CREATE('idx_standalone_global', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE')
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_global'),
'$.consistency_mode')) AS consistency_mode;
consistency_mode
standalone
SELECT VEC_INDEX_CREATE('idx_bad_consistency', 2, 'EUCLIDEAN', 'MEMORY',
'NATIVE', 0, 'durable');
ERROR HY000: Incorrect arguments to vec_index_create
CREATE TABLE t_standalone_reject(id BIGINT PRIMARY KEY, v VECTOR(2));
CREATE VECTOR INDEX ON t_standalone_reject(v)
WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE', 0, 'standalone');
ERROR HY000: Incorrect arguments to CREATE VECTOR INDEX
DROP TABLE t_standalone_reject;
SET GLOBAL vector_index_consistency_mode = @old_vector_index_consistency_mode;
SET GLOBAL vector_entry_cache_size = @old_vector_entry_cache_size;
SELECT VEC_INDEX_DROP('idx_txn_default');
VEC_INDEX_DROP('idx_txn_default')
1
SELECT VEC_INDEX_DROP('idx_standalone_arg');
VEC_INDEX_DROP('idx_standalone_arg')
1
SELECT VEC_INDEX_DROP('idx_standalone_spill');
VEC_INDEX_DROP('idx_standalone_spill')
1
SELECT VEC_INDEX_DROP('idx_standalone_global');
VEC_INDEX_DROP('idx_standalone_global')
1
