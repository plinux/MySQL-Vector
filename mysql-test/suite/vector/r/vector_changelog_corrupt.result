SELECT VEC_INDEX_CREATE('idx_changelog_corrupt', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_changelog_corrupt', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_UPSERT('idx_changelog_corrupt', 1, VEC_FROMTEXT('[1,2]'));
VEC_INDEX_UPSERT('idx_changelog_corrupt', 1, VEC_FROMTEXT('[1,2]'))
1
SELECT VEC_INDEX_SEARCH('idx_changelog_corrupt', VEC_FROMTEXT('[1,2]'), 1);
VEC_INDEX_SEARCH('idx_changelog_corrupt', VEC_FROMTEXT('[1,2]'), 1)
[1]
