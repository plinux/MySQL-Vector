#
# WL#vector-v1: recover corrupt changelog from a bound table
#
DROP TABLE IF EXISTS t_vec_changelog_corrupt;
Warnings:
Note	1051	Unknown table 'test.t_vec_changelog_corrupt'
CREATE TABLE t_vec_changelog_corrupt (
id INT PRIMARY KEY,
v VECTOR(2)
) ENGINE=InnoDB;
INSERT INTO t_vec_changelog_corrupt VALUES
(1, VEC_FROMTEXT('[1,2]'));
CREATE VECTOR INDEX ON t_vec_changelog_corrupt(v)
WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
INSERT INTO t_vec_changelog_corrupt VALUES
(2, VEC_FROMTEXT('[2,3]'));
DELETE FROM t_vec_changelog_corrupt WHERE id = 1;
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
VEC_FROMTEXT('[2,3]'), 8);
VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
VEC_FROMTEXT('[2,3]'), 8)
[2]
# restart
SELECT VEC_INDEX_LIST();
VEC_INDEX_LIST()
["test.t_vec_changelog_corrupt.v"]
SELECT JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
'$.lifecycle_state')) AS lifecycle;
lifecycle
recovery_required
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
VEC_FROMTEXT('[2,3]'), 8);
ERROR HY000: Incorrect arguments to vec_index_search
SELECT VEC_INDEX_RECOVER('test.t_vec_changelog_corrupt.v');
VEC_INDEX_RECOVER('test.t_vec_changelog_corrupt.v')
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
'$.lifecycle_state')) AS lifecycle,
JSON_EXTRACT(VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
'$.committed_entry_count') AS entries;
lifecycle	entries
ready	1
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
VEC_FROMTEXT('[2,3]'), 8);
VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
VEC_FROMTEXT('[2,3]'), 8)
[2]
