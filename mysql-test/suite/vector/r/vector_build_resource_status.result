# Process-wide vector build resource status is registered.
SELECT VARIABLE_NAME
FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'Vector_build_resource_%'
ORDER BY VARIABLE_NAME;
VARIABLE_NAME
Vector_build_resource_active_builds
Vector_build_resource_configured_memory
Vector_build_resource_effective_cpu_slots
Vector_build_resource_effective_memory
Vector_build_resource_last_effective_cpu_slots
Vector_build_resource_last_effective_memory
Vector_build_resource_memory_current
Vector_build_resource_memory_headroom
Vector_build_resource_memory_limit
Vector_build_resource_memory_reserve
Vector_build_resource_process_rss
Vector_build_resource_reserved_cpu_slots
Vector_build_resource_reserved_memory
Vector_build_resource_source
Vector_build_resource_waiting_builds
SHOW VECTOR STATUS LIKE 'Vector_build_resource_%';
Section	Variable_name	Value
GLOBAL_GAUGES	Vector_build_resource_configured_memory	<value>
GLOBAL_GAUGES	Vector_build_resource_memory_reserve	<value>
GLOBAL_GAUGES	Vector_build_resource_memory_limit	<value>
GLOBAL_GAUGES	Vector_build_resource_memory_current	<value>
GLOBAL_GAUGES	Vector_build_resource_process_rss	<value>
GLOBAL_GAUGES	Vector_build_resource_memory_headroom	<value>
GLOBAL_GAUGES	Vector_build_resource_effective_memory	<value>
GLOBAL_GAUGES	Vector_build_resource_reserved_memory	<value>
GLOBAL_GAUGES	Vector_build_resource_effective_cpu_slots	<value>
GLOBAL_GAUGES	Vector_build_resource_reserved_cpu_slots	<value>
GLOBAL_GAUGES	Vector_build_resource_active_builds	<value>
GLOBAL_GAUGES	Vector_build_resource_waiting_builds	<value>
GLOBAL_GAUGES	Vector_build_resource_last_effective_memory	<value>
GLOBAL_GAUGES	Vector_build_resource_last_effective_cpu_slots	<value>
GLOBAL_GAUGES	Vector_build_resource_source	<source>
