DROP TABLE IF EXISTS t_vector_modify_tuning;
Warnings:
Note	1051	Unknown table 'test.t_vector_modify_tuning'
CREATE TABLE t_vector_modify_tuning (
id INT PRIMARY KEY,
v VECTOR(2)
) ENGINE=InnoDB;
INSERT INTO t_vector_modify_tuning VALUES (1, VEC_FROMTEXT('[1,1]'));
CREATE VECTOR INDEX ON t_vector_modify_tuning(v)
WITH (2, 'EUCLIDEAN', 'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_SET_HNSW_BUILD_PARAMS('test.t_vector_modify_tuning.v', 24, 320);
VEC_INDEX_SET_HNSW_BUILD_PARAMS('test.t_vector_modify_tuning.v', 24, 320)
1
SELECT VEC_INDEX_SET_SEARCH_EF('test.t_vector_modify_tuning.v', 96);
VEC_INDEX_SET_SEARCH_EF('test.t_vector_modify_tuning.v', 96)
1
ALTER TABLE t_vector_modify_tuning
MODIFY COLUMN v VECTOR(2) COMMENT 'same-dim modify keeps tuning';
ALTER TABLE t_vector_modify_tuning
CHANGE COLUMN v v VECTOR(2) COMMENT 'same-dim change keeps tuning';
SHOW VECTOR STATUS FOR INDEX 'test.t_vector_modify_tuning.v'
  WHERE Variable_name = 'test.t_vector_modify_tuning.v.provider'
     OR Variable_name = 'test.t_vector_modify_tuning.v.mode'
     OR Variable_name = 'test.t_vector_modify_tuning.v.search_ef'
     OR Variable_name = 'test.t_vector_modify_tuning.v.hnsw_m'
     OR Variable_name = 'test.t_vector_modify_tuning.v.hnsw_ef_construction';
