CREATE TABLE t_vector_savepoint_atomicity (
id INT PRIMARY KEY,
v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON t_vector_savepoint_atomicity(v)
WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
# A post-core SAVEPOINT failure must roll back the complete transaction.
START TRANSACTION;
INSERT INTO t_vector_savepoint_atomicity
VALUES (1, VEC_FROMTEXT('[1,1]'));
SET SESSION debug='+d,vector_fail_savepoint_after_core';
SAVEPOINT sp_create_failure;
ERROR HY000: Internal error: vector savepoint creation failed after core savepoint
SET SESSION debug='';
SELECT COUNT(*) FROM t_vector_savepoint_atomicity WHERE id=1;
COUNT(*)
0
SELECT VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[1,1]'), 1);
VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[1,1]'), 1)
[]
# A post-core ROLLBACK TO failure must not leave a partial transaction.
START TRANSACTION;
INSERT INTO t_vector_savepoint_atomicity
VALUES (2, VEC_FROMTEXT('[2,2]'));
SAVEPOINT sp_rollback_failure;
INSERT INTO t_vector_savepoint_atomicity
VALUES (3, VEC_FROMTEXT('[3,3]'));
SET SESSION debug='+d,vector_fail_rollback_to_savepoint_after_core';
ROLLBACK TO SAVEPOINT sp_rollback_failure;
ERROR HY000: Internal error: vector rollback to savepoint failed after core rollback
SET SESSION debug='';
SELECT COUNT(*) FROM t_vector_savepoint_atomicity WHERE id IN (2,3);
COUNT(*)
0
SELECT VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[2,2]'), 2);
VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[2,2]'), 2)
[]
# A post-core RELEASE failure must also force a complete rollback.
START TRANSACTION;
INSERT INTO t_vector_savepoint_atomicity
VALUES (4, VEC_FROMTEXT('[4,4]'));
SAVEPOINT sp_release_failure;
SET SESSION debug='+d,vector_fail_release_savepoint_after_core';
RELEASE SAVEPOINT sp_release_failure;
ERROR HY000: Internal error: vector release savepoint failed after core release
SET SESSION debug='';
SELECT COUNT(*) FROM t_vector_savepoint_atomicity WHERE id=4;
COUNT(*)
0
SELECT VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[4,4]'), 1);
VEC_INDEX_SEARCH('test.t_vector_savepoint_atomicity.v',
VEC_FROMTEXT('[4,4]'), 1)
[]
DROP TABLE t_vector_savepoint_atomicity;
