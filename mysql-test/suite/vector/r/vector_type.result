#
# WL#vector-v1: VECTOR(dim) type syntax and display semantics
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
v VECTOR(3)
) ENGINE=InnoDB;
SELECT DATA_TYPE, CHARACTER_SET_NAME
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA=DATABASE()
AND TABLE_NAME='t1'
   AND COLUMN_NAME='v';
DATA_TYPE	CHARACTER_SET_NAME
vector	NULL
SELECT COLUMN_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA=DATABASE()
AND TABLE_NAME='t1'
   AND COLUMN_NAME='v';
COLUMN_TYPE
vector(3)
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `v` vector(3),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SHOW COLUMNS FROM t1;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	
v	vector(3)	YES		NULL	
DESCRIBE t1;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	
v	vector(3)	YES		NULL	
INSERT INTO t1 VALUES (1, VEC_FROMTEXT('[1,2,3]'));
SELECT id, VECTOR_DIM(v), VEC_TOTEXT(v), HEX(v) FROM t1;
id	VECTOR_DIM(v)	VEC_TOTEXT(v)	HEX(v)
1	3	[1,2,3]	0000803F0000004000004040
INSERT INTO t1 VALUES (2, VEC_FROMTEXT('[1,2]'));
ERROR HY000: Incorrect vector value: '<binary>' for column 'v' at row 1
INSERT INTO t1 VALUES (3, X'000102');
ERROR HY000: Incorrect vector value: '<binary>' for column 'v' at row 1
DROP TABLE t1;
CREATE TABLE t_invalid (v VECTOR(0));
ERROR HY000: Invalid size for column 'VECTOR'.
CREATE TABLE t_big (v VECTOR(1073741824));
ERROR 42000: Display width out of range for column 'VECTOR' (max = 1073741823)
