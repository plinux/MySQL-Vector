#
# WL#Vector: batch search thread sysvars
#
SET @old_batch_search_threads = @@global.vector_batch_search_threads;
SET @old_hnsw_search_threads = @@global.vector_hnsw_search_threads;
SET @old_faiss_search_threads = @@global.vector_faiss_search_threads;
SET @old_diskann_search_threads = @@global.vector_diskann_search_threads;
SELECT VEC_INDEX_CREATE('idx_search_threads_hnsw', 2, 'EUCLIDEAN',
'MEMORY', 'HNSWLIB');
VEC_INDEX_CREATE('idx_search_threads_hnsw', 2, 'EUCLIDEAN',
'MEMORY', 'HNSWLIB')
1
SELECT VEC_INDEX_CREATE('idx_search_threads_faiss', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS');
VEC_INDEX_CREATE('idx_search_threads_faiss', 2, 'EUCLIDEAN',
'EXTERNAL', 'FAISS')
1
SELECT VEC_INDEX_CREATE('idx_search_threads_diskann', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN');
VEC_INDEX_CREATE('idx_search_threads_diskann', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_hnsw', 1, '[1,0]');
VEC_INDEX_UPSERT('idx_search_threads_hnsw', 1, '[1,0]')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_hnsw', 2, '[0,1]');
VEC_INDEX_UPSERT('idx_search_threads_hnsw', 2, '[0,1]')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_faiss', 1, '[1,0]');
VEC_INDEX_UPSERT('idx_search_threads_faiss', 1, '[1,0]')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_faiss', 2, '[0,1]');
VEC_INDEX_UPSERT('idx_search_threads_faiss', 2, '[0,1]')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_diskann', 1, '[1,0]');
VEC_INDEX_UPSERT('idx_search_threads_diskann', 1, '[1,0]')
1
SELECT VEC_INDEX_UPSERT('idx_search_threads_diskann', 2, '[0,1]');
VEC_INDEX_UPSERT('idx_search_threads_diskann', 2, '[0,1]')
1
SET GLOBAL vector_hnsw_search_threads=0;
SET GLOBAL vector_faiss_search_threads=0;
SET GLOBAL vector_diskann_search_threads=0;
SET GLOBAL vector_batch_search_threads=1;
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_hnsw',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS hnsw_threads_1;
hnsw_threads_1
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_faiss',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS faiss_threads_1;
faiss_threads_1
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_diskann',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS diskann_threads_1;
diskann_threads_1
[[1,2],[2,1]]
SET GLOBAL vector_batch_search_threads=32;
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_hnsw',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS hnsw_threads_32;
hnsw_threads_32
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_faiss',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS faiss_threads_32;
faiss_threads_32
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_diskann',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS diskann_threads_32;
diskann_threads_32
[[1,2],[2,1]]
SET GLOBAL vector_hnsw_search_threads=1;
SET GLOBAL vector_faiss_search_threads=1;
SET GLOBAL vector_diskann_search_threads=1;
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_hnsw',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS hnsw_override_1;
hnsw_override_1
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_faiss',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS faiss_override_1;
faiss_override_1
[[1,2],[2,1]]
SELECT VEC_INDEX_SEARCH_BATCH('idx_search_threads_diskann',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2)
AS diskann_override_1;
diskann_override_1
[[1,2],[2,1]]
SET GLOBAL vector_batch_search_threads = @old_batch_search_threads;
SET GLOBAL vector_hnsw_search_threads = @old_hnsw_search_threads;
SET GLOBAL vector_faiss_search_threads = @old_faiss_search_threads;
SET GLOBAL vector_diskann_search_threads = @old_diskann_search_threads;
SELECT VEC_INDEX_DROP('idx_search_threads_hnsw');
VEC_INDEX_DROP('idx_search_threads_hnsw')
1
SELECT VEC_INDEX_DROP('idx_search_threads_faiss');
VEC_INDEX_DROP('idx_search_threads_faiss')
1
SELECT VEC_INDEX_DROP('idx_search_threads_diskann');
VEC_INDEX_DROP('idx_search_threads_diskann')
1
