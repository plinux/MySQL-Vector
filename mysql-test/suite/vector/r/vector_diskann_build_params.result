SET GLOBAL vector_diskann_max_degree=52;
SET GLOBAL vector_diskann_build_complexity=104;
SET GLOBAL vector_diskann_build_mode='auto';
SET GLOBAL vector_diskann_pq_code_budget_size=1048576;
SET GLOBAL vector_diskann_disk_pq_dims=2;
SET GLOBAL vector_diskann_accelerate_build=ON;
SET GLOBAL vector_diskann_shuffle_build=ON;
SET GLOBAL vector_diskann_use_bfs_cache=ON;
CREATE TABLE t_diskann_global_defaults (
id BIGINT NOT NULL PRIMARY KEY,
v VECTOR(2) NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_diskann_global_defaults VALUES
(1, VEC_FROMTEXT('[1,1]')),
(2, VEC_FROMTEXT('[2,2]'));
CREATE VECTOR INDEX ON t_diskann_global_defaults(v)
WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('test.t_diskann_global_defaults.v'),
'$.diskann_max_degree') AS create_max_degree,
JSON_EXTRACT(VEC_INDEX_INFO('test.t_diskann_global_defaults.v'),
'$.diskann_build_complexity') AS create_build_complexity,
JSON_EXTRACT(VEC_INDEX_INFO('test.t_diskann_global_defaults.v'),
'$.diskann_pq_code_budget_size') AS create_pq_code_budget_size,
JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('test.t_diskann_global_defaults.v'),
'$.diskann_build_mode')) AS create_build_mode;
create_max_degree	create_build_complexity	create_pq_code_budget_size	create_build_mode
52	104	1048576	auto
