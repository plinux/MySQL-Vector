SET @segmented_batch = VEC_INDEX_SEARCH_BATCH(
'idx_load_segmented',
CONCAT(VEC_FROMTEXT('[2,0]'), VEC_FROMTEXT('[1,0]')), 2, 3);
SELECT JSON_CONTAINS(JSON_EXTRACT(@segmented_batch, '$[0]'),
CAST(103 AS JSON)) AS segmented_batch_doc_103_visible,
JSON_CONTAINS(JSON_EXTRACT(@segmented_batch, '$[1]'),
CAST(101 AS JSON)) AS segmented_batch_doc_101_visible;
