#
# WL#Vector: DISKANN single-segment rerank candidate window
#
SELECT VEC_INDEX_CREATE('idx_diskann_load_segmented_single', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0, 'standalone');
VEC_INDEX_CREATE('idx_diskann_load_segmented_single', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0, 'standalone')
1
SELECT VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_load_segmented_single',
'offline');
VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_load_segmented_single',
'offline')
1
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_load_segmented_single',
32, 64, 4);
VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_diskann_load_segmented_single',
32, 64, 4)
1
SELECT VEC_INDEX_SEARCH('idx_diskann_load_segmented_single',
VEC_FROMTEXT('[1,0]'), 6);
SET @single_segment_search_info =
VEC_INDEX_INFO('idx_diskann_load_segmented_single');
SELECT JSON_EXTRACT(@single_segment_search_info,
'$.scheduler_search_fanout_segments') AS fanout_segments,
CAST(JSON_UNQUOTE(JSON_EXTRACT(@single_segment_search_info,
'$.scheduler_search_candidate_count'))
AS UNSIGNED) >
CAST(JSON_UNQUOTE(JSON_EXTRACT(@single_segment_search_info,
'$.scheduler_search_global_top_k'))
AS UNSIGNED) AS candidate_window_exceeds_topk;
fanout_segments	candidate_window_exceeds_topk
1	1
SELECT VEC_INDEX_DROP('idx_diskann_load_segmented_single');
VEC_INDEX_DROP('idx_diskann_load_segmented_single')
1
SELECT VEC_INDEX_DROP('idx_diskann_load_segmented_multi');
VEC_INDEX_DROP('idx_diskann_load_segmented_multi')
