'EXTERNAL', 'DISKANN', 0, 'standalone');
VEC_INDEX_CREATE('idx_diskann_load_segmented_multi', 2, 'EUCLIDEAN',
'EXTERNAL', 'DISKANN', 0, 'standalone')
1
SELECT VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_load_segmented_multi',
'offline');
VEC_INDEX_SET_DISKANN_BUILD_MODE('idx_diskann_load_segmented_multi',
'offline')
