#
# WL#vector-v1: SQL DDL rejects non-InnoDB mapped vector indexes
#
DROP TABLE IF EXISTS t_vector_ddl_myisam;
Warnings:
Note	1051	Unknown table 'test.t_vector_ddl_myisam'
CREATE TABLE t_vector_ddl_myisam (
id INT PRIMARY KEY,
v VECTOR(2)
) ENGINE=MyISAM;
CREATE VECTOR INDEX ON t_vector_ddl_myisam(v) WITH (2);
ERROR 42000: This version of MySQL doesn't yet support 'CREATE VECTOR INDEX on non-InnoDB tables'
DROP TABLE t_vector_ddl_myisam;
