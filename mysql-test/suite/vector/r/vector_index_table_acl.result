VEC_INDEX_UPSERT('idx_standalone_acl', 1, '[1,1]')
1
SELECT VEC_INDEX_SET_SEARCH_EF('idx_standalone_acl', 32);
VEC_INDEX_SET_SEARCH_EF('idx_standalone_acl', 32)
1
SELECT VEC_INDEX_REBUILD('idx_standalone_acl');
VEC_INDEX_REBUILD('idx_standalone_acl')
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_standalone_acl'),
