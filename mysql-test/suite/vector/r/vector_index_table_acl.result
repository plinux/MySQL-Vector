owner_index_visible_after_restart
1
GRANT DROP ON vector_acl_owner.* TO
'vec_standalone_acl_user'@'localhost';
SELECT VEC_INDEX_DROP('idx_standalone_acl');
VEC_INDEX_DROP('idx_standalone_acl')
1
