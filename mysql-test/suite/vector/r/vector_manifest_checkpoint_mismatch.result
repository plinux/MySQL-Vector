#
# WL#vector-v1: detect manifest checkpoint mismatch during startup load
#
SELECT VEC_INDEX_CREATE('idx_manifest_ckpt', 2);
VEC_INDEX_CREATE('idx_manifest_ckpt', 2)
1
SELECT VEC_INDEX_UPSERT('idx_manifest_ckpt', 1, '[1,1]');
VEC_INDEX_UPSERT('idx_manifest_ckpt', 1, '[1,1]')
1
# restart
SELECT VEC_INDEX_SEARCH('idx_manifest_ckpt', '[1,1]', 1);
VEC_INDEX_SEARCH('idx_manifest_ckpt', '[1,1]', 1)
[1]
SELECT 1 > 0;
1 > 0
1
SELECT 1 > 0;
1 > 0
1
SELECT 1 > 0;
1 > 0
1
SELECT 1 > 0;
1 > 0
1
SELECT VEC_INDEX_DROP('idx_manifest_ckpt');
VEC_INDEX_DROP('idx_manifest_ckpt')
1
