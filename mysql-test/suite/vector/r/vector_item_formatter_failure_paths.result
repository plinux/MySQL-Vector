VEC_INDEX_SEARCH('idx_formatter_fail', VEC_FROMTEXT('[1,2]'), 1)
NULL
SELECT VEC_INDEX_SEARCH_BATCH('idx_formatter_fail',
CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]')), 2, 1);
VEC_INDEX_SEARCH_BATCH('idx_formatter_fail',
CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]')), 2, 1)
