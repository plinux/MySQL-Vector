VEC_INDEX_CREATE('idx_formatter_fail', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_UPSERT('idx_formatter_fail', 1, VEC_FROMTEXT('[1,2]'));
VEC_INDEX_UPSERT('idx_formatter_fail', 1, VEC_FROMTEXT('[1,2]'))
1
SELECT VEC_INDEX_UPSERT('idx_formatter_fail', 2, VEC_FROMTEXT('[2,2]'));
VEC_INDEX_UPSERT('idx_formatter_fail', 2, VEC_FROMTEXT('[2,2]'))
1
SELECT VEC_INDEX_INFO('idx_formatter_fail');
VEC_INDEX_INFO('idx_formatter_fail')
