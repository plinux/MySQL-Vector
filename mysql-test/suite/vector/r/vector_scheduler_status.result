#
# WL#Vector: scheduler diagnostics status output
#
SET @old_vector_hnsw_build_threads = @@GLOBAL.vector_hnsw_build_threads;
SET @old_vector_faiss_build_threads = @@GLOBAL.vector_faiss_build_threads;
SET GLOBAL vector_hnsw_build_threads = 2;
SET GLOBAL vector_faiss_build_threads = 2;
SELECT VEC_INDEX_CREATE('idx_scheduler_status_hnsw', 2, 'EUCLIDEAN',
'MEMORY', 'HNSWLIB');
VEC_INDEX_CREATE('idx_scheduler_status_hnsw', 2, 'EUCLIDEAN',
'MEMORY', 'HNSWLIB')
1
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 1,
VEC_FROMTEXT('[1,0]'));
VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 1,
VEC_FROMTEXT('[1,0]'))
1
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 2,
VEC_FROMTEXT('[2,0]'));
VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 2,
VEC_FROMTEXT('[2,0]'))
1
SELECT VEC_INDEX_REBUILD('idx_scheduler_status_hnsw');
VEC_INDEX_REBUILD('idx_scheduler_status_hnsw')
1
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
'$.scheduler_path')) AS hnsw_scheduler_path,
JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
'$.scheduler_segment_count') AS hnsw_scheduler_segment_count,
JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
'$.scheduler_effective_build_threads') >= 1
AS hnsw_build_threads_present,
JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
'$.diskann_segment_pq_chunks') AS hnsw_diskann_pq_chunks,
JSON_UNQUOTE(JSON_EXTRACT(
VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
'$.diskann_segment_fallback_reason')) AS hnsw_diskann_fallback;
hnsw_scheduler_path	hnsw_scheduler_segment_count	hnsw_build_threads_present	hnsw_diskann_pq_chunks	hnsw_diskann_fallback
hnsw_scheduler	1	1	0	not_applicable
SHOW VECTOR STATUS FOR INDEX idx_scheduler_status_hnsw
WHERE Section = 'BACKEND_HEALTH'
  AND Variable_name LIKE 'idx_scheduler_status_hnsw.scheduler_%';
Section	Variable_name	Value
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_path	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_segment_count	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_task_count	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_concurrent_tasks	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_cpu_budget	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_effective_build_threads	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_effective_blas_threads	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_raw_reader_threads	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_pq_train_threads	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_pq_compress_threads	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_single_index_build	<value>
BACKEND_HEALTH	idx_scheduler_status_hnsw.scheduler_candidates_per_segment	<value>
