SHOW GLOBAL STATUS LIKE 'Vector_%';
SELECT COUNT(*) > 0 AS vector_global_status_present
FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'Vector\_%' ESCAPE '\\';
vector_global_status_present
