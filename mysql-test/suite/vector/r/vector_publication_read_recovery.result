#
# WL#Vector: publication reads recover durable intents before locking
#
CALL mtr.add_suppression(
"Vector runtime publication failed after transaction commit at stage");
SELECT VEC_INDEX_CREATE('idx_publication_read_recovery', 2,
'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_publication_read_recovery', 2,
'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_UPSERT('idx_publication_read_recovery', 1, '[1,0]');
VEC_INDEX_UPSERT('idx_publication_read_recovery', 1, '[1,0]')
1
SELECT VEC_INDEX_SEARCH('idx_publication_read_recovery',
VEC_FROMTEXT('[1,0]'), 1);
VEC_INDEX_SEARCH('idx_publication_read_recovery',
VEC_FROMTEXT('[1,0]'), 1)
[1]
SELECT VEC_INDEX_UPSERT('idx_publication_read_recovery', 2, '[0,1]');
VEC_INDEX_UPSERT('idx_publication_read_recovery', 2, '[0,1]')
1
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_publication_read_recovery'),
'$.entry_count') AS entry_count;
entry_count
2
SELECT VEC_INDEX_UPSERT('idx_publication_read_recovery', 3, '[1,1]');
VEC_INDEX_UPSERT('idx_publication_read_recovery', 3, '[1,1]')
1
SELECT VEC_INDEX_SEARCH_BATCH(
'idx_publication_read_recovery',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 3);
VEC_INDEX_SEARCH_BATCH(
'idx_publication_read_recovery',
CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 3)
[[1,3,2],[2,3,1]]
SELECT VEC_INDEX_CREATE('idx_publication_catalog_recovery', 2,
'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_publication_catalog_recovery', 2,
'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_LIST();
VEC_INDEX_LIST()
["idx_publication_catalog_recovery","idx_publication_read_recovery"]
SELECT VEC_INDEX_DROP('idx_publication_catalog_recovery');
VEC_INDEX_DROP('idx_publication_catalog_recovery')
1
SELECT VEC_INDEX_DROP('idx_publication_read_recovery');
VEC_INDEX_DROP('idx_publication_read_recovery')
1
