#
# WL#vector-v1: rollback serving state when truth-store persist fails
#
SELECT VEC_INDEX_CREATE('idx_persist_fail', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
VEC_INDEX_CREATE('idx_persist_fail', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE')
1
SELECT VEC_INDEX_UPSERT('idx_persist_fail', 1, VEC_FROMTEXT('[1,1]'));
VEC_INDEX_UPSERT('idx_persist_fail', 1, VEC_FROMTEXT('[1,1]'))
1
SET @persist_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_truth_store_persist_failures');
SET @commit_fail_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_txn_commit_failures');
SET @runtime_rollback_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_runtime_state_rollbacks');
SET @runtime_rollback_fail_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_runtime_state_rollback_failures');
SET @artifact_rollback_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollbacks');
SET @artifact_rollback_fail_before = (
SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollback_failures');
SET @txn_fail = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_persist_fail', @txn_fail, 2, VEC_FROMTEXT('[2,2]'));
VEC_INDEX_STAGE_UPSERT('idx_persist_fail', @txn_fail, 2, VEC_FROMTEXT('[2,2]'))
1
SELECT VEC_INDEX_TXN_COMMIT(@txn_fail);
ERROR HY000: Incorrect arguments to vec_index_txn_commit
SELECT VEC_INDEX_TXN_PENDING(@txn_fail);
VEC_INDEX_TXN_PENDING(@txn_fail)
1
SELECT VEC_INDEX_SEARCH('idx_persist_fail', VEC_FROMTEXT('[2,2]'), 10);
VEC_INDEX_SEARCH('idx_persist_fail', VEC_FROMTEXT('[2,2]'), 10)
[1]
SELECT VEC_INDEX_TXN_ROLLBACK(@txn_fail);
VEC_INDEX_TXN_ROLLBACK(@txn_fail)
1
SELECT VEC_INDEX_TXN_PENDING(@txn_fail);
VEC_INDEX_TXN_PENDING(@txn_fail)
