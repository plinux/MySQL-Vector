--source include/have_vector_faiss.inc

--echo #
--echo # WL#vector-v1: configure FAISS IVF params through SQL functions
--echo #

SET GLOBAL vector_lazy_external_runtime=OFF;

SELECT VEC_INDEX_CREATE('idx_faiss_ivf', 2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_faiss_ivf', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_UPSERT('idx_faiss_ivf', 9, VEC_FROMTEXT('[9,9]'));

SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf', 2, 1);
SELECT VEC_INDEX_REBUILD('idx_faiss_ivf');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf'),
         '$.backend_build_reader_passes') AS faiss_reader_passes,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf'),
         '$.backend_build_training_rows') AS faiss_training_rows;

--replace_column 3 <value>
SHOW VECTOR STATUS FOR INDEX idx_faiss_ivf
WHERE Section = 'BACKEND_HEALTH'
  AND Variable_name LIKE 'idx_faiss_ivf.backend_build_reader_%';

--source suite/vector/include/vector_normalize_lifecycle_build_timing.inc
SELECT VEC_INDEX_INFO('idx_faiss_ivf');
SET @ivf_generation_before_nprobe =
  JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf'),
    '$.external_manifest_generation'));
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.backend_variant';
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.faiss_nlist';
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.faiss_nprobe';
SELECT VEC_INDEX_SEARCH('idx_faiss_ivf', VEC_FROMTEXT('[1,1]'), 1);

SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf', 2, 2);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf'), '$.faiss_nprobe')
  AS faiss_nprobe_after_runtime_update;
SELECT @ivf_generation_before_nprobe =
  JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf'),
    '$.external_manifest_generation')) AS runtime_update_kept_generation;

SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf', 1, 1);

--source include/restart_mysqld.inc

--source suite/vector/include/vector_normalize_lifecycle_build_timing.inc
SELECT VEC_INDEX_INFO('idx_faiss_ivf');
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.backend_variant';
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.faiss_nlist';
SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name = 'idx_faiss_ivf.faiss_nprobe';
SELECT VEC_INDEX_SEARCH('idx_faiss_ivf', VEC_FROMTEXT('[1,1]'), 1);

SELECT VEC_INDEX_DROP('idx_faiss_ivf');
SET GLOBAL vector_lazy_external_runtime=DEFAULT;
