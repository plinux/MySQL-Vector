  '$.backend_build_resource_reserved_memory',
  '$.backend_build_resource_effective_memory',
  '$.backend_build_resource_effective_cpu_slots',
  '$.backend_build_resource_reserved_cpu_slots',
  '$.backend_build_resource_active_builds',
  '$.backend_build_resource_waiting_builds',
  '$.backend_build_effective_threads',
  '$.backend_build_effective_blas_threads',
  '$.scheduler_cpu_budget',
  '$.scheduler_effective_build_threads',
  '$.scheduler_effective_blas_threads') AS CHAR) =
