SELECT CAST(JSON_REMOVE(VEC_INDEX_INFO('idx_item_binlog_ivfpq'),
  '$.last_apply_latency_ms', '$.external_manifest_generation',
  '$.backend_build_input_source', '$.backend_build_reader_passes',
