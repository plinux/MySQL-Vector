--source include/have_vector_debug_native.inc
--source include/have_vector_faiss.inc
--source include/have_vector_diskann.inc

--echo #
--echo # WL#vector-v1: item_vectorfunc binlog helper failure branches
--echo #

--disable_query_log
SET GLOBAL debug = '+d,vector_item_fail_binlog_write';
--enable_query_log

SELECT VEC_INDEX_CREATE('idx_item_binlog_fail_mem', 2, 'COSINE', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_LIST();
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_mem'), '$.backend_variant');

SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_mem', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_SEARCH('idx_item_binlog_fail_mem', VEC_FROMTEXT('[1,1]'), 2);
SELECT VEC_INDEX_ERASE('idx_item_binlog_fail_mem', 1);
SELECT VEC_INDEX_SEARCH('idx_item_binlog_fail_mem', VEC_FROMTEXT('[1,1]'), 2);

SELECT VEC_INDEX_CREATE('idx_item_binlog_fail_ext', 2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN');
--replace_regex /^diskann_[a-z_]+$/<diskann_variant>/
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ext'), '$.backend_variant'));
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS('idx_item_binlog_fail_ext', 48, 96);
SELECT VEC_INDEX_SET_DISKANN_SEARCH_COMPLEXITY('idx_item_binlog_fail_ext', 80);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ext'), '$.diskann_max_degree');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ext'), '$.diskann_build_complexity');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ext'), '$.diskann_search_complexity');

SELECT VEC_INDEX_CREATE('idx_item_binlog_fail_faiss', 2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_SET_SEARCH_EF('idx_item_binlog_fail_faiss', 96);
SELECT VEC_INDEX_SET_HNSW_BUILD_PARAMS('idx_item_binlog_fail_faiss', 24, 320);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.search_ef');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.hnsw_m');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.hnsw_ef_construction');
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_faiss', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_faiss', 2, VEC_FROMTEXT('[2,2]'));
SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_item_binlog_fail_faiss', 2, 1);
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.backend_variant'));
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.faiss_nlist');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_faiss'), '$.faiss_nprobe');

SELECT VEC_INDEX_CREATE('idx_item_binlog_fail_ivfpq', 4, 'EUCLIDEAN', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_ivfpq', 1, VEC_FROMTEXT('[1,0,0,0]'));
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_ivfpq', 2, VEC_FROMTEXT('[0,1,0,0]'));
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_ivfpq', 3, VEC_FROMTEXT('[0,0,1,0]'));
SELECT VEC_INDEX_UPSERT('idx_item_binlog_fail_ivfpq', 4, VEC_FROMTEXT('[0,0,0,1]'));
SELECT VEC_INDEX_SET_FAISS_IVFPQ_PARAMS('idx_item_binlog_fail_ivfpq', 2, 1, 1, 1);
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ivfpq'), '$.backend_variant'));
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ivfpq'), '$.faiss_nlist');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ivfpq'), '$.faiss_nprobe');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ivfpq'), '$.faiss_pq_m');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_item_binlog_fail_ivfpq'), '$.faiss_pq_bits');

SELECT VEC_INDEX_REBUILD('idx_item_binlog_fail_mem');
SELECT VEC_INDEX_RECOVER('idx_item_binlog_fail_mem');
SELECT VEC_INDEX_REBUILD_ALL();
SELECT VEC_INDEX_RECOVER_ALL();

SELECT VEC_INDEX_DROP('idx_item_binlog_fail_mem');
SELECT VEC_INDEX_DROP('idx_item_binlog_fail_ext');
SELECT VEC_INDEX_DROP('idx_item_binlog_fail_faiss');
SELECT VEC_INDEX_DROP('idx_item_binlog_fail_ivfpq');
SELECT VEC_INDEX_LIST();

--disable_query_log
SET GLOBAL debug = '-d,vector_item_fail_binlog_write';
--enable_query_log
