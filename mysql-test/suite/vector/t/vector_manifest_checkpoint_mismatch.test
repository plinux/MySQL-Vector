--source include/have_vector_index.inc
--source include/have_debug.inc

--echo #
--echo # WL#vector-v1: detect manifest checkpoint mismatch during startup load
--echo #

SELECT VEC_INDEX_CREATE('idx_manifest_ckpt', 2);
SELECT VEC_INDEX_UPSERT('idx_manifest_ckpt', 1, '[1,1]');

--source suite/vector/include/vector_truth_store_backend.inc

--let $datadir=`SELECT @@datadir`
--let $manifest_file=$datadir/mysql_vector_index/manifest.v1
if ($is_mysql_truth_store)
{
  --disable_query_log
  --disable_result_log
  SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('manifest',
            '6d7973716c2d766563746f722d6d616e69666573742d76310a726561647909310939393939093939393909393939390a');
  --enable_result_log
  --enable_query_log
}
if (!$is_mysql_truth_store)
{
  --exec sed -i '' '2s/.*/ready\t1\t9999\t9999\t9999/' $manifest_file
}

--source include/restart_mysqld.inc

SELECT VEC_INDEX_SEARCH('idx_manifest_ckpt', '[1,1]', 1);

--let $meta_after= query_get_value("SHOW GLOBAL STATUS LIKE 'Vector_metadata_load_failures'", Value, 1)
--let $committed_after= query_get_value("SHOW GLOBAL STATUS LIKE 'Vector_committed_load_failures'", Value, 1)
--let $manifest_after= query_get_value("SHOW GLOBAL STATUS LIKE 'Vector_manifest_load_failures'", Value, 1)
--let $changelog_after= query_get_value("SHOW GLOBAL STATUS LIKE 'Vector_change_log_load_failures'", Value, 1)

--eval SELECT $meta_after > 0
--eval SELECT $committed_after > 0
--eval SELECT $manifest_after > 0
--eval SELECT $changelog_after > 0

SELECT VEC_INDEX_DROP('idx_manifest_ckpt');
