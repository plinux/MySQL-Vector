--source include/have_vector_debug_native.inc
--source include/have_debug_sync.inc

--echo #
--echo # WL#Vector: erase waits for an uncommitted delete-mark rollback
--echo #

--disable_result_log
DROP TABLE IF EXISTS t_vector_delete_mark_locking;
CREATE TABLE t_vector_delete_mark_locking (
  id BIGINT UNSIGNED PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON t_vector_delete_mark_locking(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
INSERT INTO t_vector_delete_mark_locking
  VALUES (1, VEC_FROMTEXT('[1,1]'));

connect (con_delete_rollback_a,localhost,root,,test,,);
connect (con_delete_rollback_b,localhost,root,,test,,);

connection con_delete_rollback_a;
START TRANSACTION;
DELETE FROM t_vector_delete_mark_locking WHERE id=1;

connection con_delete_rollback_b;
SET @txn_rollback_b = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_ERASE(
  'test.t_vector_delete_mark_locking.v', @txn_rollback_b, 1);
SET DEBUG_SYNC =
  'vector_truth_store_row_lock_wait SIGNAL rollback_b_waiting';
--send SELECT VEC_INDEX_TXN_COMMIT(@txn_rollback_b)

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR rollback_b_waiting TIMEOUT 30';

connection con_delete_rollback_a;
ROLLBACK;

connection con_delete_rollback_b;
--reap
SET DEBUG_SYNC = 'RESET';
--enable_result_log

SELECT VEC_INDEX_SEARCH(
  'test.t_vector_delete_mark_locking.v', '[1,1]', 1);

--disable_result_log
connection default;
disconnect con_delete_rollback_a;
disconnect con_delete_rollback_b;

--echo #
--echo # WL#Vector: erase waits for an uncommitted delete-mark commit
--echo #

UPDATE t_vector_delete_mark_locking
  SET v=VEC_FROMTEXT('[2,2]') WHERE id=1;
connect (con_delete_commit_a,localhost,root,,test,,);
connect (con_delete_commit_b,localhost,root,,test,,);

connection con_delete_commit_a;
START TRANSACTION;
DELETE FROM t_vector_delete_mark_locking WHERE id=1;

connection con_delete_commit_b;
SET @txn_commit_b = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_ERASE(
  'test.t_vector_delete_mark_locking.v', @txn_commit_b, 1);
SET DEBUG_SYNC = 'vector_truth_store_row_lock_wait SIGNAL commit_b_waiting';
--send SELECT VEC_INDEX_TXN_COMMIT(@txn_commit_b)

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR commit_b_waiting TIMEOUT 30';

connection con_delete_commit_a;
COMMIT;

connection con_delete_commit_b;
--reap
SET DEBUG_SYNC = 'RESET';
--enable_result_log

SELECT VEC_INDEX_TXN_PENDING(@txn_commit_b);
SELECT VEC_INDEX_TXN_COMMIT(@txn_commit_b);
SELECT VEC_INDEX_SEARCH(
  'test.t_vector_delete_mark_locking.v', '[2,2]', 1);

--disable_result_log
connection default;
disconnect con_delete_commit_a;
disconnect con_delete_commit_b;
DROP VECTOR INDEX ON t_vector_delete_mark_locking(v);
DROP TABLE t_vector_delete_mark_locking;
--enable_result_log
