--source include/have_vector_diskann.inc

SET @old_batch_search_threads = @@GLOBAL.vector_batch_search_threads;
SET @old_provider_search_threads = @@GLOBAL.vector_diskann_search_threads;
SET GLOBAL vector_diskann_search_threads = 1;

--let $vector_index_name=idx_search_threads_diskann
--let $vector_mode=EXTERNAL
--let $vector_provider=DISKANN
--source suite/vector/include/vector_provider_search_threads.inc

SET GLOBAL vector_batch_search_threads = @old_batch_search_threads;
SET GLOBAL vector_diskann_search_threads = @old_provider_search_threads;
