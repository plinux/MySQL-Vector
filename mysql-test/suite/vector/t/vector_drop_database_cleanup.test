--source include/have_vector_index.inc
--source include/have_vector_search_library.inc

--echo #
--echo # WL#vector-v1: DROP DATABASE should clean mapped vector indexes
--echo #

DROP DATABASE IF EXISTS vec_dropdb;
CREATE DATABASE vec_dropdb;

CREATE TABLE vec_dropdb.t_vec_dropdb (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON vec_dropdb.t_vec_dropdb(v) WITH (2);
INSERT INTO vec_dropdb.t_vec_dropdb VALUES (1, VEC_FROMTEXT('[1,1]'));

SELECT VEC_INDEX_LIST();
SELECT VEC_INDEX_SEARCH('vec_dropdb.t_vec_dropdb.v', '[1,1]', 1);

DROP DATABASE vec_dropdb;

SELECT VEC_INDEX_LIST();
