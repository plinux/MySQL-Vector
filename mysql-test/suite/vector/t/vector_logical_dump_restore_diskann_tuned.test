--source include/have_vector_index.inc
--source include/have_vector_diskann.inc

--echo #
--echo # WL#vector-v1: logical dump and restore preserves DISKANN tuning
--echo #

--let $dump_file= $MYSQLTEST_VARDIR/tmp/vector_logical_dump_restore_diskann_tuned.sql

DROP TABLE IF EXISTS t_vector_logical_dump_restore_diskann_tuned;
CREATE TABLE t_vector_logical_dump_restore_diskann_tuned (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;

INSERT INTO t_vector_logical_dump_restore_diskann_tuned VALUES
  (1, VEC_FROMTEXT('[1,1]')),
  (9, VEC_FROMTEXT('[9,9]'));
CREATE VECTOR INDEX ON t_vector_logical_dump_restore_diskann_tuned(v)
  WITH (2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN');
SELECT VEC_INDEX_SET_DISKANN_BUILD_PARAMS(
  'test.t_vector_logical_dump_restore_diskann_tuned.v', 48, 96);
SELECT VEC_INDEX_SET_DISKANN_SEARCH_COMPLEXITY(
  'test.t_vector_logical_dump_restore_diskann_tuned.v', 80);
SELECT VEC_INDEX_SET_DISKANN_PQ_CODE_BUDGET_SIZE(
  'test.t_vector_logical_dump_restore_diskann_tuned.v', 1048576);

--exec $MYSQL_DUMP --skip-comments test t_vector_logical_dump_restore_diskann_tuned > $dump_file

DROP TABLE t_vector_logical_dump_restore_diskann_tuned;
--exec $MYSQL test < $dump_file

SHOW VECTOR STATUS FOR INDEX 'test.t_vector_logical_dump_restore_diskann_tuned.v'
  WHERE Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.provider'
     OR Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.mode'
     OR Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.diskann_max_degree'
     OR Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.diskann_build_complexity'
     OR Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.diskann_search_complexity'
     OR Variable_name = 'test.t_vector_logical_dump_restore_diskann_tuned.v.diskann_pq_code_budget_size';
SELECT VEC_INDEX_SEARCH('test.t_vector_logical_dump_restore_diskann_tuned.v',
                        VEC_FROMTEXT('[9,9]'), 1);

DROP TABLE t_vector_logical_dump_restore_diskann_tuned;
--remove_file $dump_file
