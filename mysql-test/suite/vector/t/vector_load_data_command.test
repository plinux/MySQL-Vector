--source include/have_vector_debug_native.inc

--echo #
--echo # WL#Vector: LOAD VECTOR DATA command and standalone import
--echo #

--disable_query_log
--let $vector_fbin=$MYSQLTEST_VARDIR/vector_load_data.fbin
--let $vector_docid=$MYSQLTEST_VARDIR/vector_load_data.u64
--let $vector_replace_fbin=$MYSQLTEST_VARDIR/vector_load_data_replace.fbin
--let $vector_replace_docid=$MYSQLTEST_VARDIR/vector_load_data_replace.u64
--let $vector_csv=$MYSQLTEST_VARDIR/vector_load_data.csv
--let $vector_csv_replace=$MYSQLTEST_VARDIR/vector_load_data_replace.csv
--let $vector_csv_bad_dim=$MYSQLTEST_VARDIR/vector_load_data_bad_dim.csv
--let $vector_csv_crlf=$MYSQLTEST_VARDIR/vector_load_data_crlf.csv
--let $vector_csv_atomic=$MYSQLTEST_VARDIR/vector_load_data_atomic.csv
--let $vector_source_dir=$MYSQLTEST_VARDIR/vector_load_data_source_dir
--let $vector_docid_dir=$MYSQLTEST_VARDIR/vector_load_data_docid_dir
--let vector_fbin=$vector_fbin
--let vector_docid=$vector_docid
--let vector_replace_fbin=$vector_replace_fbin
--let vector_replace_docid=$vector_replace_docid
--let vector_csv=$vector_csv
--let vector_csv_replace=$vector_csv_replace
--let vector_csv_bad_dim=$vector_csv_bad_dim
--let vector_csv_crlf=$vector_csv_crlf
--let vector_csv_atomic=$vector_csv_atomic
--let vector_source_dir=$vector_source_dir
--let vector_docid_dir=$vector_docid_dir
--let $vector_std_fbin_target=$vector_fbin
--let $vector_std_docid_target=$vector_docid
--source suite/vector/include/vector_copy_std_load_data_files.inc
--copy_file $MYSQL_TEST_DIR/suite/vector/std_data/vector_load_data_replace.fbin $vector_replace_fbin
--copy_file $MYSQL_TEST_DIR/suite/vector/std_data/vector_load_data_replace.u64 $vector_replace_docid
--write_file $vector_csv
doc_id,vector
201,"[1,0]"

202,"[0,1]"
EOF
--write_file $vector_csv_replace
doc_id,vector
202,"[0,2]"
EOF
--write_file $vector_csv_bad_dim
doc_id,vector
203,"[1,2,3]"
EOF
--exec printf 'doc_id,vector\r\n204,"[2,0]"\r\n' > $vector_csv_crlf
--write_file $vector_csv_atomic
doc_id,vector
301,"[1,0]"
302,"[0,1]"
EOF
--exec mkdir -p $vector_source_dir $vector_docid_dir
--enable_query_log

--error ER_WRONG_ARGUMENTS
LOAD VECTOR DATA INFILE 'vectors.fbin'
  INTO VECTOR INDEX idx_load_missing
  FORMAT FBIN;

--error ER_WRONG_ARGUMENTS
LOAD VECTOR DATA INFILE 'vectors.fbin'
  INTO VECTOR INDEX ``
  FORMAT FBIN;

SELECT VEC_INDEX_CREATE('idx_load_transactional', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE');
--disable_query_log
--error ER_NOT_SUPPORTED_YET
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_transactional
  FORMAT JSON;
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data.u64'
  INTO VECTOR INDEX idx_load_transactional
  FORMAT CSV;
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_transactional
  FORMAT CSV
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_transactional', VEC_FROMTEXT('[1,0]'), 1),
  CAST(201 AS JSON)) AS transactional_csv_visible;

SELECT VEC_INDEX_CREATE('idx_load_transactional_atomic', 2, 'EUCLIDEAN',
                        'MEMORY', 'NATIVE');
--disable_query_log
--connect (con_load_atomic,localhost,root,,test)
SET DEBUG_SYNC =
  'vector_load_after_staging SIGNAL vector_load_staged WAIT_FOR vector_load_continue TIMEOUT 30';
--send
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_atomic.csv'
  INTO VECTOR INDEX idx_load_transactional_atomic
  FORMAT CSV
  REBUILD;

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR vector_load_staged TIMEOUT 30';
--remove_file $vector_csv_atomic
--write_file $vector_csv_atomic
doc_id,vector
301,"[0,1]"
302,"[1,0]"
EOF
SET DEBUG_SYNC = 'now SIGNAL vector_load_continue';

--connection con_load_atomic
--reap
SET DEBUG_SYNC = 'RESET';
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_transactional_atomic', VEC_FROMTEXT('[1,0]'), 1),
  CAST(301 AS JSON)) AS transactional_staged_source_visible;
--disconnect con_load_atomic
--connection default

DROP USER IF EXISTS 'vec_load_acl'@'localhost';
DROP DATABASE IF EXISTS vector_load_acl_db;
CREATE USER 'vec_load_acl'@'localhost';
CREATE DATABASE vector_load_acl_db;
USE vector_load_acl_db;
SELECT VEC_INDEX_CREATE('idx_load_acl_transactional', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE');
SELECT VEC_INDEX_CREATE('idx_load_acl_standalone', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
GRANT FILE ON *.* TO 'vec_load_acl'@'localhost';
GRANT SELECT ON vector_load_acl_db.* TO 'vec_load_acl'@'localhost';

--connect (con_load_acl,localhost,vec_load_acl,,vector_load_acl_db)
--disable_query_log
--error ER_TABLEACCESS_DENIED_ERROR,ER_DBACCESS_DENIED_ERROR,ER_ACCESS_DENIED_ERROR
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_acl_transactional
  FORMAT CSV
  REBUILD;
--error ER_TABLEACCESS_DENIED_ERROR,ER_DBACCESS_DENIED_ERROR,ER_ACCESS_DENIED_ERROR
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_acl_standalone
  FORMAT CSV
  REBUILD;
--enable_query_log
--disconnect con_load_acl

--connection default
GRANT ALTER ON *.* TO 'vec_load_acl'@'localhost';

--connect (con_load_acl,localhost,vec_load_acl,,vector_load_acl_db)
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_acl_transactional
  FORMAT CSV
  REBUILD;
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_acl_standalone
  FORMAT CSV
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_acl_transactional', VEC_FROMTEXT('[1,0]'), 1),
  CAST(201 AS JSON)) AS transactional_acl_visible;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_acl_standalone', VEC_FROMTEXT('[0,1]'), 1),
  CAST(202 AS JSON)) AS standalone_acl_visible;
--disconnect con_load_acl

--connection default
SELECT VEC_INDEX_DROP('idx_load_acl_transactional');
SELECT VEC_INDEX_DROP('idx_load_acl_standalone');
USE test;
DROP DATABASE vector_load_acl_db;
DROP USER 'vec_load_acl'@'localhost';

SELECT VEC_INDEX_CREATE('idx_load_standalone', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
SET @old_local_infile = @@GLOBAL.local_infile;
SET @old_vector_build_segment_max_rows = @@GLOBAL.vector_build_segment_max_rows;
SET @old_vector_build_segment_target_size = @@GLOBAL.vector_build_segment_target_size;
SET GLOBAL local_infile = ON;
--error ER_NOT_SUPPORTED_YET
LOAD VECTOR DATA LOCAL INFILE 'vectors.fbin'
  DOCID INFILE 'docids.u64'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT FBIN
  REBUILD;

SET GLOBAL local_infile = OFF;
--error ER_CLIENT_LOCAL_FILES_DISABLED
LOAD VECTOR DATA LOCAL INFILE 'vectors.fbin'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT FBIN;
SET GLOBAL local_infile = @old_local_infile;

--disable_query_log
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_source_dir'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV;
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.fbin'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data_docid_dir'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT FBIN;
--enable_query_log

--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.csv'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_standalone', VEC_FROMTEXT('[0,1]'), 1),
  CAST(202 AS JSON)) AS standalone_csv_visible;
--disable_query_log
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.csv'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV
  REBUILD;
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_bad_dim.csv'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV
  REBUILD;
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.csv'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV
  REPLACE
  REBUILD;
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_crlf.csv'
  INTO VECTOR INDEX idx_load_standalone
  FORMAT CSV
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_standalone', VEC_FROMTEXT('[0,2]'), 1),
  CAST(202 AS JSON)) AS standalone_csv_replace_visible;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_standalone', VEC_FROMTEXT('[2,0]'), 1),
  CAST(204 AS JSON)) AS standalone_csv_crlf_visible;

SELECT VEC_INDEX_CREATE('idx_load_pending', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.fbin'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data.u64'
  INTO VECTOR INDEX idx_load_pending
  FORMAT FBIN;
--enable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_load_pending'),
                                 '$.lifecycle_state')) AS lifecycle_state;
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_load_pending'),
                    '$.standalone_raw_segment_count') AS raw_segment_count,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_load_pending'),
                    '$.standalone_raw_segment_bytes') > 0 AS has_raw_bytes;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('idx_load_pending', VEC_FROMTEXT('[1,0]'), 1);
SELECT VEC_INDEX_BULK_BUILD('idx_load_pending');
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_load_pending'),
                                 '$.build_source')) AS build_source;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_pending', VEC_FROMTEXT('[1,0]'), 2),
  CAST(101 AS JSON)) AS has_doc_101,
  JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_pending', VEC_FROMTEXT('[1,0]'), 2),
  CAST(103 AS JSON)) AS has_doc_103;
--disable_query_log
--error ER_WRONG_ARGUMENTS
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.fbin'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.u64'
  INTO VECTOR INDEX idx_load_pending
  FORMAT FBIN
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_pending', VEC_FROMTEXT('[1,0]'), 1),
  CAST(101 AS JSON)) AS original_doc_still_visible;
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.fbin'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data_replace.u64'
  INTO VECTOR INDEX idx_load_pending
  FORMAT FBIN
  REPLACE
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_pending', VEC_FROMTEXT('[0,2]'), 1),
  CAST(101 AS JSON)) AS replaced_doc_visible;

SELECT VEC_INDEX_CREATE('idx_load_segmented', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
SET GLOBAL vector_build_segment_max_rows = 1;
SET GLOBAL vector_build_segment_target_size = 1048576;
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.fbin'
  DOCID INFILE '$MYSQLTEST_VARDIR/vector_load_data.u64'
  INTO VECTOR INDEX idx_load_segmented
  FORMAT FBIN;
--enable_query_log
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_load_segmented'),
                    '$.standalone_raw_segment_count') AS raw_segment_count;
SELECT VEC_INDEX_BULK_BUILD('idx_load_segmented');
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_load_segmented'),
                                 '$.build_pipeline_decision')) AS decision,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_load_segmented'),
                    '$.build_pipeline_raw_segments') AS raw_segments;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_segmented', VEC_FROMTEXT('[2,0]'), 3),
  CAST(103 AS JSON)) AS segmented_doc_visible;
SET @segmented_batch = VEC_INDEX_SEARCH_BATCH(
  'idx_load_segmented',
  CONCAT(VEC_FROMTEXT('[2,0]'), VEC_FROMTEXT('[1,0]')), 2, 3);
SELECT JSON_CONTAINS(JSON_EXTRACT(@segmented_batch, '$[0]'),
                     CAST(103 AS JSON)) AS segmented_batch_doc_103_visible,
       JSON_CONTAINS(JSON_EXTRACT(@segmented_batch, '$[1]'),
                     CAST(101 AS JSON)) AS segmented_batch_doc_101_visible;
SET GLOBAL vector_build_segment_max_rows = 2;
SELECT VEC_INDEX_CREATE('idx_load_mixed_segments', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.fbin'
  INTO VECTOR INDEX idx_load_mixed_segments
  FORMAT FBIN;
--enable_query_log
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_load_mixed_segments'),
                    '$.standalone_raw_segment_count')
  AS raw_segment_count_before_delta;
SELECT VEC_INDEX_UPSERT('idx_load_mixed_segments', 900001,
                        VEC_FROMTEXT('[0.9,0.1]'));
SELECT VEC_INDEX_BULK_BUILD('idx_load_mixed_segments');
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_load_mixed_segments'),
                                 '$.build_source')) AS build_source,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_load_mixed_segments'),
                    '$.standalone_raw_segment_count') AS raw_segment_count,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_load_mixed_segments'),
                    '$.build_pipeline_raw_segments') AS raw_segments,
       JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_load_mixed_segments'),
                                 '$.build_segment_policy')) AS segment_policy;
SET GLOBAL vector_build_segment_max_rows = @old_vector_build_segment_max_rows;
SET GLOBAL vector_build_segment_target_size = @old_vector_build_segment_target_size;

SELECT VEC_INDEX_CREATE('idx_load_generated_docid', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_load_data.fbin'
  INTO VECTOR INDEX idx_load_generated_docid
  FORMAT FBIN
  REBUILD;
--enable_query_log
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_generated_docid', VEC_FROMTEXT('[1,0]'), 2),
  CAST(0 AS JSON)) AS generated_doc_0_visible,
  JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_load_generated_docid', VEC_FROMTEXT('[2,0]'), 3),
  CAST(2 AS JSON)) AS generated_doc_2_visible;

SELECT VEC_INDEX_DROP('idx_load_transactional');
SELECT VEC_INDEX_DROP('idx_load_transactional_atomic');
SELECT VEC_INDEX_DROP('idx_load_standalone');
SELECT VEC_INDEX_DROP('idx_load_pending');
SELECT VEC_INDEX_DROP('idx_load_segmented');
SELECT VEC_INDEX_DROP('idx_load_mixed_segments');
SELECT VEC_INDEX_DROP('idx_load_generated_docid');
--remove_file $vector_fbin
--remove_file $vector_docid
--remove_file $vector_replace_fbin
--remove_file $vector_replace_docid
--remove_file $vector_csv
--remove_file $vector_csv_replace
--remove_file $vector_csv_bad_dim
--remove_file $vector_csv_crlf
--remove_file $vector_csv_atomic
--exec rmdir $vector_source_dir $vector_docid_dir
