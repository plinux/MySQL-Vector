--source include/have_vector_index.inc
--source include/have_vector_faiss.inc
--source include/have_vector_hnsw.inc
--source include/have_vector_diskann.inc

--source include/have_debug.inc

--echo #
--echo # WL#vector-v1: backend failure paths keep serving state consistent
--echo #

SELECT VEC_INDEX_CREATE('idx_hnsw_replace_regress', 2, 'EUCLIDEAN', 'MEMORY',
                        'HNSWLIB');
SELECT VEC_INDEX_UPSERT('idx_hnsw_replace_regress', 1, VEC_FROMTEXT('[0,0]'));
SELECT VEC_INDEX_UPSERT('idx_hnsw_replace_regress', 2, VEC_FROMTEXT('[10,10]'));
SELECT VEC_INDEX_UPSERT('idx_hnsw_replace_regress', 1, VEC_FROMTEXT('[100,100]'));
SELECT VEC_INDEX_SEARCH('idx_hnsw_replace_regress', VEC_FROMTEXT('[0,0]'), 1);
SELECT VEC_INDEX_DROP('idx_hnsw_replace_regress');

SELECT VEC_INDEX_CREATE('idx_faiss_rebuild_regress', 2, 'EUCLIDEAN',
                        'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_faiss_rebuild_regress', 1, VEC_FROMTEXT('[1,1]'));
--disable_query_log
SET GLOBAL debug = '+d,vector_backend_fail_faiss_external_rebuild';
--enable_query_log
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_UPSERT('idx_faiss_rebuild_regress', 2, VEC_FROMTEXT('[2,2]'));
--disable_query_log
SET GLOBAL debug = '-d,vector_backend_fail_faiss_external_rebuild';
--enable_query_log
SELECT VEC_INDEX_SEARCH('idx_faiss_rebuild_regress', VEC_FROMTEXT('[2,2]'), 2);
SELECT VEC_INDEX_DROP('idx_faiss_rebuild_regress');

SELECT VEC_INDEX_CREATE('idx_diskann_truth_regress', 2, 'EUCLIDEAN',
                        'EXTERNAL', 'DISKANN');
SELECT VEC_INDEX_UPSERT('idx_diskann_truth_regress', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_UPSERT('idx_diskann_truth_regress', 9, VEC_FROMTEXT('[9,9]'));
--let $datadir=`SELECT @@datadir`
--let $manifest_file=$datadir/mysql_vector_index/6964785f6469736b616e6e5f74727574685f72656772657373/diskann_external.manifest.v1
--exec printf "broken-manifest\n" > $manifest_file
SELECT VEC_INDEX_RECOVER('idx_diskann_truth_regress');
SELECT VEC_INDEX_SEARCH('idx_diskann_truth_regress', VEC_FROMTEXT('[1,1]'), 1);
SELECT VEC_INDEX_SEARCH('idx_diskann_truth_regress', VEC_FROMTEXT('[9,9]'), 1);
SELECT VEC_INDEX_DROP('idx_diskann_truth_regress');
