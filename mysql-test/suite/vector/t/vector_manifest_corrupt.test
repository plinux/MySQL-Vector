--source include/have_vector_debug_native.inc

--echo #
--echo # WL#vector-v1: quarantine corrupt manifest artifact during startup load
--echo #

SELECT VEC_INDEX_CREATE('idx_manifest_corrupt', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_UPSERT('idx_manifest_corrupt', 1, VEC_FROMTEXT('[1,2]'));
SELECT VEC_INDEX_SEARCH('idx_manifest_corrupt', VEC_FROMTEXT('[1,2]'), 1);

--source suite/vector/include/vector_truth_store_backend.inc

--let $datadir=`SELECT @@datadir`
--let $manifest_file=$datadir/mysql_vector_index/manifest.v1
--let $manifest_backup_file=$MYSQLTEST_VARDIR/tmp/vector_manifest_corrupt.v1
if ($is_mysql_truth_store)
{
  --disable_query_log
  --disable_result_log
  --let $manifest_backup= query_get_value("SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest') AS value", value, 1)
  SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX(
    'manifest', '6261640a726f770a');
  --enable_result_log
  --enable_query_log
}
if (!$is_mysql_truth_store)
{
  --exec cp $manifest_file $manifest_backup_file
  --exec printf 'bad\nrow\n' > $manifest_file
}

--source include/restart_mysqld.inc

--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_LIST();
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('idx_manifest_corrupt', VEC_FROMTEXT('[1,2]'), 1);
--echo SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest');
--disable_query_log
if ($is_mysql_truth_store)
{
SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest');
}
if (!$is_mysql_truth_store)
{
SELECT '' AS `VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest')`;
}
--enable_query_log
--replace_column 2 <num>
SHOW GLOBAL STATUS LIKE 'Vector_metadata_load_failures';
--replace_column 2 <num>
SHOW GLOBAL STATUS LIKE 'Vector_manifest_load_failures';

if ($is_mysql_truth_store)
{
  --disable_query_log
  --disable_result_log
  --eval SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('manifest', '$manifest_backup');
  --enable_result_log
  --enable_query_log
}
if (!$is_mysql_truth_store)
{
  --exec mv $manifest_backup_file $manifest_file
}

--source include/restart_mysqld.inc

SELECT VEC_INDEX_LIST();
SELECT VEC_INDEX_SEARCH('idx_manifest_corrupt', VEC_FROMTEXT('[1,2]'), 1);
SELECT VEC_INDEX_DROP('idx_manifest_corrupt');
--exec rm -f $manifest_backup_file
