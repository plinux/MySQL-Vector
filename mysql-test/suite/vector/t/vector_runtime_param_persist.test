--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: runtime parameter updates persist index metadata
--echo #

SELECT VEC_INDEX_CREATE('idx_runtime_param', 2, 'COSINE', 'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_UPSERT('idx_runtime_param', 1, VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_runtime_param', 2, VEC_FROMTEXT('[0,1]'));
SELECT VEC_INDEX_SEARCH('idx_runtime_param', VEC_FROMTEXT('[1,0]'), 1);

SET @persist_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_requests');
SELECT VEC_INDEX_SET_SEARCH_EF('idx_runtime_param', 96);
SET @persist_after = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_requests');

SELECT @persist_after > @persist_before;
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_runtime_param'), '$.search_ef');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_runtime_param'), '$.committed_entry_count');
SELECT VEC_INDEX_SEARCH('idx_runtime_param', VEC_FROMTEXT('[1,0]'), 1);

--source include/restart_mysqld.inc

SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_runtime_param'), '$.search_ef');
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_runtime_param'), '$.committed_entry_count');
SELECT VEC_INDEX_SEARCH('idx_runtime_param', VEC_FROMTEXT('[1,0]'), 1);

SELECT VEC_INDEX_DROP('idx_runtime_param');
