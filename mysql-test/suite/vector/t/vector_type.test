--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: VECTOR(dim) type syntax and display semantics
--echo #

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  v VECTOR(3)
) ENGINE=InnoDB;

SELECT DATA_TYPE, CHARACTER_SET_NAME
  FROM INFORMATION_SCHEMA.COLUMNS
 WHERE TABLE_SCHEMA=DATABASE()
   AND TABLE_NAME='t1'
   AND COLUMN_NAME='v';

SELECT COLUMN_TYPE
  FROM INFORMATION_SCHEMA.COLUMNS
 WHERE TABLE_SCHEMA=DATABASE()
   AND TABLE_NAME='t1'
   AND COLUMN_NAME='v';

SHOW CREATE TABLE t1;
SHOW COLUMNS FROM t1;
DESCRIBE t1;

INSERT INTO t1 VALUES (1, VEC_FROMTEXT('[1,2,3]'));
SELECT id, VECTOR_DIM(v), VEC_TOTEXT(v), HEX(v) FROM t1;

--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t1 VALUES (2, VEC_FROMTEXT('[1,2]'));
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t1 VALUES (3, X'000102');

DROP TABLE t1;

--error ER_INVALID_FIELD_SIZE
CREATE TABLE t_invalid (v VECTOR(0));
