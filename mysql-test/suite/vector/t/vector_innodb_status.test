--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: vector observability summary in SHOW ENGINE INNODB STATUS
--echo #

SELECT VEC_INDEX_CREATE('idx_is', 2);
SELECT VEC_INDEX_UPSERT('idx_is', 1, '[1,2]');

SET @txn1 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_is', @txn1, 2, '[2,2]');
SELECT VEC_INDEX_STAGE_ERASE('idx_is', @txn1, 1);
SELECT VEC_INDEX_TXN_ROLLBACK(@txn1);

SELECT VEC_INDEX_SEARCH('idx_is', '[1,2]', 1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('idx_is_missing', '[1,2]', 1);

SELECT VEC_INDEX_REBUILD('idx_is');
SELECT VEC_INDEX_RECOVER('idx_is');
SELECT VEC_INDEX_REBUILD_ALL();
SELECT VEC_INDEX_RECOVER_ALL();

SELECT VEC_INDEX_CREATE('idx_is_ext', 2, 'EUCLIDEAN', 'EXTERNAL', 'DISKANN');
SET @txn2 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_is_ext', @txn2, 9, '[9,9]');
SELECT VEC_INDEX_TXN_COMMIT(@txn2);
SELECT VEC_INDEX_SEARCH('idx_is_ext', '[9,9]', 1);

SET @metadata_load_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_metadata_load_failures');
SET @metadata_persist_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_metadata_persist_failures');
SET @truth_store_backend = (
  SELECT VARIABLE_VALUE
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_backend');
SET @truth_store_transactional = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_transactional');
SET @truth_store_persist_req = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_requests');
SET @truth_store_persist_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_truth_store_persist_failures');
SET @committed_load_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_committed_load_failures');
SET @committed_persist_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_committed_persist_failures');
SET @committed_rows = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_committed_snapshot_rows');
SET @manifest_version = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_version');
SET @manifest_meta_ckpt = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_metadata_checkpoint');
SET @manifest_committed_ckpt = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_committed_checkpoint');
SET @manifest_change_log_ckpt = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SET @manifest_load_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_load_failures');
SET @manifest_persist_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_persist_failures');
SET @change_log_load_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_change_log_load_failures');
SET @change_log_replay_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_change_log_replay_failures');
SET @change_log_persist_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_change_log_persist_failures');
SET @backend_recover_fallback = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_backend_recover_fallbacks');
SET @persist_artifact_rollback = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollbacks');
SET @persist_artifact_rollback_fail = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_persist_artifact_rollback_failures');

--exec $MYSQL -e "SHOW ENGINE INNODB STATUS\\G" > $MYSQL_TMP_DIR/vector_innodb_status.txt
--error 1
--exec grep -E "vector indexes:|vector index states:|vector backend modes:|vector search:|vector maintenance:|vector txn:" $MYSQL_TMP_DIR/vector_innodb_status.txt
--remove_file $MYSQL_TMP_DIR/vector_innodb_status.txt

--replace_regex /\n/<EOL>/ /.*<EOL>vector metadata: load_fail=([0-9]+), persist_fail=([0-9]+)<EOL>.*/\1,\2/
--let $vector_metadata_line=`SHOW ENGINE INNODB STATUS`
--let $vector_metadata_line=`SELECT LTRIM(RIGHT('$vector_metadata_line', LENGTH('$vector_metadata_line') - 6))`
--let $vector_metadata_line=`SELECT REGEXP_REPLACE('$vector_metadata_line', '[[:space:]]+', '')`
--let $expected_vector_metadata_line=`SELECT CONCAT(@metadata_load_fail, ',', @metadata_persist_fail)`
--let $assert_text= InnoDB status vector-metadata line matches global status values
--let $assert_cond= "$vector_metadata_line" = "$expected_vector_metadata_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector truth store: backend=([^,]+), transactional=([0-9]+)<EOL>.*/\1,\2/
--let $vector_truth_store_line=`SHOW ENGINE INNODB STATUS`
--let $vector_truth_store_line=`SELECT LTRIM(RIGHT('$vector_truth_store_line', LENGTH('$vector_truth_store_line') - 6))`
--let $vector_truth_store_line=`SELECT REGEXP_REPLACE('$vector_truth_store_line', '[[:space:]]+', '')`
--let $expected_vector_truth_store_line=`SELECT CONCAT(@truth_store_backend, ',', @truth_store_transactional)`
--let $assert_text= InnoDB status vector-truth-store line matches global status values
--let $assert_cond= "$vector_truth_store_line" = "$expected_vector_truth_store_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector truth-store persist: requests=([0-9]+), failures=([0-9]+)<EOL>.*/\1,\2/
--let $vector_truth_store_persist_line=`SHOW ENGINE INNODB STATUS`
--let $vector_truth_store_persist_line=`SELECT LTRIM(RIGHT('$vector_truth_store_persist_line', LENGTH('$vector_truth_store_persist_line') - 6))`
--let $vector_truth_store_persist_line=`SELECT REGEXP_REPLACE('$vector_truth_store_persist_line', '[[:space:]]+', '')`
--let $expected_vector_truth_store_persist_line=`SELECT CONCAT(@truth_store_persist_req, ',', @truth_store_persist_fail)`
--let $assert_text= InnoDB status vector-truth-store-persist line matches global status values
--let $assert_cond= "$vector_truth_store_persist_line" = "$expected_vector_truth_store_persist_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector committed snapshot: rows=([0-9]+), load_fail=([0-9]+), persist_fail=([0-9]+)<EOL>.*/\1,\2,\3/
--let $vector_committed_line=`SHOW ENGINE INNODB STATUS`
--let $vector_committed_line=`SELECT LTRIM(RIGHT('$vector_committed_line', LENGTH('$vector_committed_line') - 6))`
--let $vector_committed_line=`SELECT REGEXP_REPLACE('$vector_committed_line', '[[:space:]]+', '')`
--let $expected_vector_committed_line=`SELECT CONCAT(@committed_rows, ',', @committed_load_fail, ',', @committed_persist_fail)`
--let $assert_text= InnoDB status vector-committed line matches global status values
--let $assert_cond= "$vector_committed_line" = "$expected_vector_committed_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector manifest: version=([0-9]+), metadata_ckpt=([0-9]+), committed_ckpt=([0-9]+), change_log_ckpt=([0-9]+), load_fail=([0-9]+), persist_fail=([0-9]+)<EOL>.*/\1,\2,\3,\4,\5,\6/
--let $vector_manifest_line=`SHOW ENGINE INNODB STATUS`
--let $vector_manifest_line=`SELECT LTRIM(RIGHT('$vector_manifest_line', LENGTH('$vector_manifest_line') - 6))`
--let $vector_manifest_line=`SELECT REGEXP_REPLACE('$vector_manifest_line', '[[:space:]]+', '')`
--let $expected_vector_manifest_line=`SELECT CONCAT(@manifest_version, ',', @manifest_meta_ckpt, ',', @manifest_committed_ckpt, ',', @manifest_change_log_ckpt, ',', @manifest_load_fail, ',', @manifest_persist_fail)`
--let $assert_text= InnoDB status vector-manifest line matches global status values
--let $assert_cond= "$vector_manifest_line" = "$expected_vector_manifest_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector change-log: load_fail=([0-9]+), replay_fail=([0-9]+), persist_fail=([0-9]+), backend_recover_fallback=([0-9]+)<EOL>.*/\1,\2,\3,\4/
--let $vector_change_log_line=`SHOW ENGINE INNODB STATUS`
--let $vector_change_log_line=`SELECT LTRIM(RIGHT('$vector_change_log_line', LENGTH('$vector_change_log_line') - 6))`
--let $vector_change_log_line=`SELECT REGEXP_REPLACE('$vector_change_log_line', '[[:space:]]+', '')`
--let $expected_vector_change_log_line=`SELECT CONCAT(@change_log_load_fail, ',', @change_log_replay_fail, ',', @change_log_persist_fail, ',', @backend_recover_fallback)`
--let $assert_text= InnoDB status vector-change-log line matches global status values
--let $assert_cond= "$vector_change_log_line" = "$expected_vector_change_log_line"
--source include/assert.inc

--replace_regex /\n/<EOL>/ /.*<EOL>vector artifact rollback: persist_artifact=([0-9]+), persist_artifact_fail=([0-9]+)<EOL>.*/\1,\2/
--let $vector_artifact_rollback_line=`SHOW ENGINE INNODB STATUS`
--let $vector_artifact_rollback_line=`SELECT LTRIM(RIGHT('$vector_artifact_rollback_line', LENGTH('$vector_artifact_rollback_line') - 6))`
--let $vector_artifact_rollback_line=`SELECT REGEXP_REPLACE('$vector_artifact_rollback_line', '[[:space:]]+', '')`
--let $expected_vector_artifact_rollback_line=`SELECT CONCAT(@persist_artifact_rollback, ',', @persist_artifact_rollback_fail)`
--let $assert_text= InnoDB status vector-artifact-rollback line matches global status values
--let $assert_cond= "$vector_artifact_rollback_line" = "$expected_vector_artifact_rollback_line"
--source include/assert.inc

SELECT VEC_INDEX_DROP('idx_is');
SELECT VEC_INDEX_DROP('idx_is_ext');
