--source include/have_vector_hnsw.inc
--source include/have_vector_faiss.inc

--echo #
--echo # WL#Vector: generic runtime scheduler diagnostics for HNSW and FAISS
--echo #

SET @old_vector_hnsw_build_threads = @@GLOBAL.vector_hnsw_build_threads;
SET @old_vector_faiss_build_threads = @@GLOBAL.vector_faiss_build_threads;

SET GLOBAL vector_hnsw_build_threads = 2;
SET GLOBAL vector_faiss_build_threads = 2;

SELECT VEC_INDEX_CREATE('idx_scheduler_hnsw', 2, 'EUCLIDEAN',
                        'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_UPSERT('idx_scheduler_hnsw', 1, VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_scheduler_hnsw', 2, VEC_FROMTEXT('[2,0]'));
SELECT VEC_INDEX_REBUILD('idx_scheduler_hnsw');

SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_hnsw'),
         '$.backend_build_runtime')) AS hnsw_runtime,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_hnsw'),
         '$.backend_build_effective_threads') >= 1 AS hnsw_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_hnsw'),
         '$.backend_build_effective_blas_threads') AS hnsw_blas_threads,
       COALESCE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_hnsw'),
         '$.backend_build_pq_chunks'), 0) AS hnsw_pq_chunks,
       COALESCE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_hnsw'),
         '$.backend_build_cache_nodes'), 0) AS hnsw_cache_nodes;

SELECT VEC_INDEX_CREATE('idx_scheduler_faiss', 2, 'EUCLIDEAN',
                        'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_scheduler_faiss', 1, VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_scheduler_faiss', 2, VEC_FROMTEXT('[2,0]'));
SELECT VEC_INDEX_REBUILD('idx_scheduler_faiss');

SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_faiss'),
         '$.backend_build_runtime')) AS faiss_runtime,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_faiss'),
         '$.backend_build_effective_threads') >= 1 AS faiss_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_faiss'),
         '$.backend_build_effective_blas_threads') >= 1
         AS faiss_blas_threads_present,
       COALESCE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_faiss'),
         '$.backend_build_pq_chunks'), 0) AS faiss_pq_chunks,
       COALESCE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_faiss'),
         '$.backend_build_cache_nodes'), 0) AS faiss_cache_nodes;

SET GLOBAL vector_hnsw_build_threads = @old_vector_hnsw_build_threads;
SET GLOBAL vector_faiss_build_threads = @old_vector_faiss_build_threads;

SELECT VEC_INDEX_DROP('idx_scheduler_hnsw');
SELECT VEC_INDEX_DROP('idx_scheduler_faiss');
