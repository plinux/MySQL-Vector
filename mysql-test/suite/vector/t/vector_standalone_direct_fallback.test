--source include/have_vector_index.inc
--source include/have_vector_faiss.inc
--source include/have_vector_hnsw.inc

--echo #
--echo # WL#Vector: standalone providers without Knowhere
--echo #

let $have_knowhere = `SELECT COALESCE(MAX(VARIABLE_VALUE = '1'), 0) FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Vector_knowhere_enabled'`;
if ($have_knowhere)
{
  --skip Test requires standalone direct fallback without Knowhere
}

--disable_query_log
--let $vector_csv=$MYSQLTEST_VARDIR/vector_standalone_direct_fallback.csv
--let vector_csv=$vector_csv
--write_file $vector_csv
doc_id,vector
401,"[1,0]"
402,"[0,1]"
EOF
--enable_query_log

SELECT VEC_INDEX_CREATE('idx_direct_hnsw', 2, 'EUCLIDEAN', 'MEMORY',
                        'HNSWLIB', 0, 'standalone');
SELECT VEC_INDEX_CREATE('idx_direct_faiss', 2, 'EUCLIDEAN', 'EXTERNAL',
                        'FAISS', 0, 'standalone');

--disable_query_log
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_standalone_direct_fallback.csv'
  INTO VECTOR INDEX idx_direct_hnsw
  FORMAT CSV
  REBUILD;
eval LOAD VECTOR DATA INFILE '$MYSQLTEST_VARDIR/vector_standalone_direct_fallback.csv'
  INTO VECTOR INDEX idx_direct_faiss
  FORMAT CSV
  REBUILD;
--enable_query_log

SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_direct_hnsw', VEC_FROMTEXT('[1,0]'), 1),
  CAST(401 AS JSON)) AS hnsw_doc_visible;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_direct_faiss', VEC_FROMTEXT('[0,1]'), 1),
  CAST(402 AS JSON)) AS faiss_doc_visible;
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_direct_hnsw'),
                                 '$.backend_variant')) AS hnsw_variant,
       JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_direct_faiss'),
                                 '$.backend_variant')) AS faiss_variant;

SELECT VEC_INDEX_DROP('idx_direct_hnsw');
SELECT VEC_INDEX_DROP('idx_direct_faiss');

--remove_file $vector_csv
