--source include/have_vector_index.inc
--source include/have_vector_faiss.inc
--source include/have_vector_hnsw.inc

--echo #
--echo # WL#vector-v1: configure HNSW search ef through SQL functions
--echo #

SELECT VEC_INDEX_CREATE('idx_search_ef_mem', 2, 'COSINE', 'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_CREATE('idx_search_ef_ext', 2, 'COSINE', 'EXTERNAL', 'FAISS');

SELECT VEC_INDEX_SET_SEARCH_EF('idx_search_ef_mem', 96);
SELECT VEC_INDEX_SET_SEARCH_EF('idx_search_ef_ext', 128);

--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_search_ef_mem');
--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_search_ef_ext');

SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name LIKE 'idx_search_ef_%.search_ef';

--source include/restart_mysqld.inc

--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_search_ef_mem');
--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_search_ef_ext');

SHOW VECTOR STATUS WHERE Section = 'INDEX_STATE'
  AND Variable_name LIKE 'idx_search_ef_%.search_ef';

SELECT VEC_INDEX_DROP('idx_search_ef_mem');
SELECT VEC_INDEX_DROP('idx_search_ef_ext');
