--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: TRUNCATE TABLE resets mapped vector indexes
--echo #

DROP TABLE IF EXISTS t_vec_truncate_sync;
CREATE TABLE t_vec_truncate_sync (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;

CREATE VECTOR INDEX ON t_vec_truncate_sync(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_SET_HNSW_BUILD_PARAMS('test.t_vec_truncate_sync.v', 24, 320);
SELECT VEC_INDEX_SET_SEARCH_EF('test.t_vec_truncate_sync.v', 96);
INSERT INTO t_vec_truncate_sync VALUES
  (1, VEC_FROMTEXT('[1,1]')),
  (2, VEC_FROMTEXT('[2,2]'));

SELECT VEC_INDEX_SEARCH('test.t_vec_truncate_sync.v', '[1,1]', 8);
--replace_regex /"lifecycle_version":[0-9]+/"lifecycle_version":<num>/ /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
SELECT VEC_INDEX_INFO('test.t_vec_truncate_sync.v');

TRUNCATE TABLE t_vec_truncate_sync;

SELECT VEC_INDEX_SEARCH('test.t_vec_truncate_sync.v', '[1,1]', 8);
--replace_regex /"lifecycle_version":[0-9]+/"lifecycle_version":<num>/ /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
SELECT VEC_INDEX_INFO('test.t_vec_truncate_sync.v');
SHOW VECTOR STATUS FOR INDEX 'test.t_vec_truncate_sync.v'
  WHERE Variable_name = 'test.t_vec_truncate_sync.v.search_ef'
     OR Variable_name = 'test.t_vec_truncate_sync.v.hnsw_m'
     OR Variable_name = 'test.t_vec_truncate_sync.v.hnsw_ef_construction';

INSERT INTO t_vec_truncate_sync VALUES (3, VEC_FROMTEXT('[3,3]'));
SELECT VEC_INDEX_SEARCH('test.t_vec_truncate_sync.v', '[3,3]', 8);

DROP TABLE t_vec_truncate_sync;
