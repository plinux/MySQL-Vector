--source include/have_vector_hnsw.inc
--source include/have_vector_faiss.inc
--source include/have_vector_diskann.inc

--echo #
--echo # WL#Vector: scheduler diagnostics status output
--echo #

SET @old_vector_hnsw_build_threads = @@GLOBAL.vector_hnsw_build_threads;
SET @old_vector_faiss_build_threads = @@GLOBAL.vector_faiss_build_threads;

SET GLOBAL vector_hnsw_build_threads = 2;
SET GLOBAL vector_faiss_build_threads = 2;

SELECT VEC_INDEX_CREATE('idx_scheduler_status_hnsw', 2, 'EUCLIDEAN',
                        'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 1,
                        VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_hnsw', 2,
                        VEC_FROMTEXT('[2,0]'));
SELECT VEC_INDEX_REBUILD('idx_scheduler_status_hnsw');

SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
         '$.scheduler_path')) AS hnsw_scheduler_path,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
         '$.scheduler_segment_count') AS hnsw_scheduler_segment_count,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
         '$.scheduler_effective_build_threads') >= 1
         AS hnsw_build_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
         '$.diskann_segment_pq_chunks') AS hnsw_diskann_pq_chunks,
       JSON_UNQUOTE(JSON_EXTRACT(
         VEC_INDEX_INFO('idx_scheduler_status_hnsw'),
         '$.diskann_segment_fallback_reason')) AS hnsw_diskann_fallback;

--replace_column 3 <value>
SHOW VECTOR STATUS FOR INDEX idx_scheduler_status_hnsw
WHERE Section = 'BACKEND_HEALTH'
  AND Variable_name LIKE 'idx_scheduler_status_hnsw.scheduler_%';

SELECT VEC_INDEX_CREATE('idx_scheduler_status_faiss', 2, 'EUCLIDEAN',
                        'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_faiss', 1,
                        VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_faiss', 2,
                        VEC_FROMTEXT('[2,0]'));
SELECT VEC_INDEX_REBUILD('idx_scheduler_status_faiss');

SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_faiss'),
         '$.scheduler_path')) AS faiss_scheduler_path,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_faiss'),
         '$.scheduler_effective_blas_threads') >= 1
         AS faiss_blas_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_faiss'),
         '$.diskann_segment_cache_nodes') AS faiss_diskann_cache_nodes,
       JSON_UNQUOTE(JSON_EXTRACT(
         VEC_INDEX_INFO('idx_scheduler_status_faiss'),
         '$.diskann_segment_fallback_reason')) AS faiss_diskann_fallback;

--disable_result_log
SHOW GLOBAL STATUS LIKE 'Vector_%';
--enable_result_log
SELECT COUNT(*) > 0 AS vector_global_status_present
FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'Vector\_%' ESCAPE '\\';

SELECT VEC_INDEX_CREATE('idx_scheduler_status_diskann', 2, 'EUCLIDEAN',
                        'EXTERNAL', 'DISKANN');
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_diskann', 1,
                        VEC_FROMTEXT('[1,0]'));
SELECT VEC_INDEX_UPSERT('idx_scheduler_status_diskann', 2,
                        VEC_FROMTEXT('[2,0]'));
SELECT VEC_INDEX_REBUILD('idx_scheduler_status_diskann');

--replace_column 1 <diskann_runtime>
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_path')) AS diskann_scheduler_path,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_task_count') > 0 AS diskann_tasks_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_concurrent_tasks') >= 1 AS diskann_concurrency_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_cpu_budget') >= 1 AS diskann_cpu_budget_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_effective_build_threads') >= 1
         AS diskann_build_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_effective_blas_threads') >= 1
         AS diskann_blas_threads_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.scheduler_segment_count') >= 0 AS diskann_segments_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.diskann_segment_pq_chunks') >= 0 AS diskann_pq_chunks_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.diskann_segment_cache_nodes') >= 0 AS diskann_cache_nodes_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.diskann_segment_build_wall_ms') >= 0 AS diskann_wall_ms_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.diskann_segment_build_sum_ms') >= 0 AS diskann_sum_ms_present,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_scheduler_status_diskann'),
         '$.diskann_segment_fallback_reason') IS NOT NULL
         AS diskann_fallback_field_present;

--replace_column 3 <value>
SHOW VECTOR STATUS FOR INDEX idx_scheduler_status_diskann
WHERE Section = 'BACKEND_HEALTH'
  AND Variable_name LIKE 'idx_scheduler_status_diskann.scheduler_%';

--replace_column 3 <value>
SHOW VECTOR STATUS FOR INDEX idx_scheduler_status_diskann
WHERE Section = 'BACKEND_HEALTH'
  AND Variable_name LIKE 'idx_scheduler_status_diskann.diskann_segment_%';

--disable_query_log
SET GLOBAL vector_hnsw_build_threads = @old_vector_hnsw_build_threads;
SET GLOBAL vector_faiss_build_threads = @old_vector_faiss_build_threads;
--enable_query_log

SELECT VEC_INDEX_DROP('idx_scheduler_status_hnsw');
SELECT VEC_INDEX_DROP('idx_scheduler_status_faiss');
SELECT VEC_INDEX_DROP('idx_scheduler_status_diskann');
