--source include/have_vector_faiss.inc
--source include/have_debug.inc

--echo #
--echo # WL#vector-v1: FAISS IVF nprobe update avoids external rebuild
--echo #

SELECT VEC_INDEX_CREATE('idx_faiss_ivf_nprobe', 2, 'EUCLIDEAN', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_faiss_ivf_nprobe', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_UPSERT('idx_faiss_ivf_nprobe', 9, VEC_FROMTEXT('[9,9]'));
SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf_nprobe', 2, 1);

--disable_query_log
SET SESSION debug = '+d,vector_backend_fail_faiss_external_rebuild';
--enable_query_log

SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf_nprobe', 2, 2);
SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf_nprobe'), '$.faiss_nprobe')
  AS faiss_nprobe_after_runtime_update;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS('idx_faiss_ivf_nprobe', 1, 1);

--disable_query_log
SET SESSION debug = '-d,vector_backend_fail_faiss_external_rebuild';
--enable_query_log

--source include/restart_mysqld.inc

SELECT JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf_nprobe'), '$.faiss_nlist')
         AS faiss_nlist_after_restart,
       JSON_EXTRACT(VEC_INDEX_INFO('idx_faiss_ivf_nprobe'), '$.faiss_nprobe')
         AS faiss_nprobe_after_restart;

SELECT VEC_INDEX_DROP('idx_faiss_ivf_nprobe');
