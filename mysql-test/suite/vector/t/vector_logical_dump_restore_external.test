--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: logical dump and restore preserves EXTERNAL vector indexes
--echo #

--let $dump_file= $MYSQLTEST_VARDIR/tmp/vector_logical_dump_restore_external.sql

DROP TABLE IF EXISTS t_vector_logical_dump_restore_external;
CREATE TABLE t_vector_logical_dump_restore_external (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;

INSERT INTO t_vector_logical_dump_restore_external VALUES
  (1, VEC_FROMTEXT('[1,0]')),
  (2, VEC_FROMTEXT('[0,1]'));
CREATE VECTOR INDEX ON t_vector_logical_dump_restore_external(v)
  WITH (2, 'COSINE', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_SET_FAISS_IVF_PARAMS(
  'test.t_vector_logical_dump_restore_external.v', 2, 1);

--exec $MYSQL_DUMP --skip-comments test t_vector_logical_dump_restore_external > $dump_file

DROP TABLE t_vector_logical_dump_restore_external;
--exec $MYSQL test < $dump_file

SHOW VECTOR STATUS FOR INDEX 'test.t_vector_logical_dump_restore_external.v'
  WHERE Variable_name = 'test.t_vector_logical_dump_restore_external.v.provider'
     OR Variable_name = 'test.t_vector_logical_dump_restore_external.v.mode'
     OR Variable_name = 'test.t_vector_logical_dump_restore_external.v.backend_variant'
     OR Variable_name = 'test.t_vector_logical_dump_restore_external.v.faiss_nlist'
     OR Variable_name = 'test.t_vector_logical_dump_restore_external.v.faiss_nprobe';
SELECT VEC_INDEX_SEARCH('test.t_vector_logical_dump_restore_external.v',
                        VEC_FROMTEXT('[0,1]'), 1);

DROP TABLE t_vector_logical_dump_restore_external;
--remove_file $dump_file
