--source include/have_vector_index.inc
--source include/have_vector_hnsw.inc

--echo #
--echo # WL#Vector: statement publication cannot mix with attached table DML
--echo #

--disable_warnings
DROP TABLE IF EXISTS t_vector_mixed_publication;
--enable_warnings
CREATE TABLE t_vector_mixed_publication (
  id INT PRIMARY KEY,
  v VECTOR(2),
  marker INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO t_vector_mixed_publication VALUES
  (1, VEC_FROMTEXT('[1,1]'), 0),
  (2, VEC_FROMTEXT('[2,2]'), 0);
CREATE VECTOR INDEX ON t_vector_mixed_publication(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'HNSWLIB');
SELECT VEC_INDEX_SET_SEARCH_EF('test.t_vector_mixed_publication.v', 80);

--echo # Statement publication is evaluated before attached DML staging.
--error ER_INTERNAL_ERROR
UPDATE t_vector_mixed_publication
SET marker = VEC_INDEX_SET_SEARCH_EF(
               'test.t_vector_mixed_publication.v', 96),
    v = VEC_FROMTEXT('[9,9]')
WHERE id = 1;

SELECT id, VEC_TOTEXT(v), marker
FROM t_vector_mixed_publication ORDER BY id;
SELECT JSON_EXTRACT(
  VEC_INDEX_INFO('test.t_vector_mixed_publication.v'), '$.search_ef') AS search_ef;

--echo # Attached DML from the first row is staged before the second row calls
--echo # the statement publication function.
--error ER_WRONG_ARGUMENTS
UPDATE t_vector_mixed_publication
SET v = VEC_FROMTEXT(CONCAT('[', id + 10, ',', id + 10, ']')),
    marker = IF(id = 2,
      VEC_INDEX_SET_SEARCH_EF('test.t_vector_mixed_publication.v', 112),
      marker)
ORDER BY id;

SELECT id, VEC_TOTEXT(v), marker
FROM t_vector_mixed_publication ORDER BY id;
SELECT JSON_EXTRACT(
  VEC_INDEX_INFO('test.t_vector_mixed_publication.v'), '$.search_ef') AS search_ef;

--echo # Restart verifies that neither rejected statement left durable truth or
--echo # configuration state.
--source include/restart_mysqld.inc

SELECT id, VEC_TOTEXT(v), marker
FROM t_vector_mixed_publication ORDER BY id;
SELECT JSON_EXTRACT(
  VEC_INDEX_INFO('test.t_vector_mixed_publication.v'), '$.search_ef') AS search_ef;

DROP VECTOR INDEX ON t_vector_mixed_publication(v);
DROP TABLE t_vector_mixed_publication;
