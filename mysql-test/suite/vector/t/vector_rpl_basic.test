  WHERE Variable_name = 'test.t_vec_rpl_modify.v.provider'
     OR Variable_name = 'test.t_vec_rpl_modify.v.mode'
     OR Variable_name = 'test.t_vec_rpl_modify.v.search_ef'
     OR Variable_name = 'test.t_vec_rpl_modify.v.hnsw_m'
     OR Variable_name = 'test.t_vec_rpl_modify.v.hnsw_ef_construction';
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('test.t_vec_rpl_modify.v', '[61,61]', 8), CAST(61 AS JSON));

--connection master
DROP TABLE t_vec_rpl_modify;
save_master_pos;

--connection slave
sync_with_master;
SELECT VEC_INDEX_LIST();

--connection master
DROP DATABASE IF EXISTS vec_rpl_drop_db;
CREATE DATABASE vec_rpl_drop_db;
CREATE TABLE vec_rpl_drop_db.t_vec_drop_db (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON vec_rpl_drop_db.t_vec_drop_db(v) WITH (2);
INSERT INTO vec_rpl_drop_db.t_vec_drop_db VALUES (71, VEC_FROMTEXT('[71,71]'));
save_master_pos;

SELECT VEC_INDEX_LIST();

--connection slave
sync_with_master;
SELECT VEC_INDEX_LIST();
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('vec_rpl_drop_db.t_vec_drop_db.v', '[71,71]', 8),
  CAST(71 AS JSON));

--connection master
DROP DATABASE vec_rpl_drop_db;
save_master_pos;

--connection slave
sync_with_master;
SELECT VEC_INDEX_LIST();

--connection master
DROP TABLE t_vec_rpl;
