--source include/have_vector_index.inc

--source include/not_group_replication_plugin.inc
--source include/master-slave.inc

--connection master
SELECT VEC_INDEX_DROP('idx_fn_rpl');
SELECT VEC_INDEX_CREATE('idx_fn_rpl', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_UPSERT('idx_fn_rpl', 1, '[1,1]');
SELECT VEC_INDEX_REBUILD('idx_fn_rpl');
SHOW VECTOR STATUS FOR INDEX 'idx_fn_rpl'
  WHERE Variable_name = 'idx_fn_rpl.lifecycle_version';
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_fn_rpl', '[1,1]', 8), CAST(1 AS JSON));
save_master_pos;

--connection slave
sync_with_master;
SELECT VEC_INDEX_LIST();
SHOW VECTOR STATUS FOR INDEX 'idx_fn_rpl'
  WHERE Variable_name = 'idx_fn_rpl.lifecycle_version';
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_fn_rpl', '[1,1]', 8), CAST(1 AS JSON));

--connection master
SELECT VEC_INDEX_RECOVER('idx_fn_rpl');
SHOW VECTOR STATUS FOR INDEX 'idx_fn_rpl'
  WHERE Variable_name = 'idx_fn_rpl.lifecycle_version';
save_master_pos;

--connection slave
sync_with_master;
SHOW VECTOR STATUS FOR INDEX 'idx_fn_rpl'
  WHERE Variable_name = 'idx_fn_rpl.lifecycle_version';

--connection master
SELECT VEC_INDEX_ERASE('idx_fn_rpl', 1);
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_fn_rpl', '[1,1]', 8), CAST(1 AS JSON));
save_master_pos;

--connection slave
sync_with_master;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_fn_rpl', '[1,1]', 8), CAST(1 AS JSON));

--connection master
SELECT VEC_INDEX_DROP('idx_fn_rpl');
save_master_pos;

--connection slave
sync_with_master;
SELECT VEC_INDEX_LIST();

--connection master
--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc
