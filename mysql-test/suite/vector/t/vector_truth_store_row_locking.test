--source include/have_vector_debug_native.inc
--source include/have_debug_sync.inc

--echo #
--echo # WL#Vector: row truth writers do not serialize through shared scratch
--echo #

DROP TABLE IF EXISTS t_vector_row_lock_a;
DROP TABLE IF EXISTS t_vector_row_lock_b;
CREATE TABLE t_vector_row_lock_a (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE TABLE t_vector_row_lock_b (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON t_vector_row_lock_a(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
CREATE VECTOR INDEX ON t_vector_row_lock_b(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
INSERT INTO t_vector_row_lock_a VALUES (1, VEC_FROMTEXT('[1,1]'));
INSERT INTO t_vector_row_lock_b VALUES (1, VEC_FROMTEXT('[2,2]'));

connect (con_writer_a,localhost,root,,test,,);
connect (con_writer_b,localhost,root,,test,,);

connection con_writer_a;
SET DEBUG_SYNC =
  'vector_truth_store_committed_writer_ready SIGNAL writer_a_ready WAIT_FOR continue_writer_a TIMEOUT 10';
--send UPDATE t_vector_row_lock_a SET v=VEC_FROMTEXT('[3,3]') WHERE id=1

connection default;
SET DEBUG_SYNC = 'now WAIT_FOR writer_a_ready TIMEOUT 10';

connection con_writer_b;
UPDATE t_vector_row_lock_b SET v=VEC_FROMTEXT('[4,4]') WHERE id=1;

connection default;
SET DEBUG_SYNC = 'now SIGNAL continue_writer_a';

connection con_writer_a;
--reap
SET DEBUG_SYNC = 'RESET';

connection default;
disconnect con_writer_a;
disconnect con_writer_b;

SELECT VEC_INDEX_SEARCH('test.t_vector_row_lock_a.v', '[3,3]', 1);
SELECT VEC_INDEX_SEARCH('test.t_vector_row_lock_b.v', '[4,4]', 1);

DROP VECTOR INDEX ON t_vector_row_lock_a(v);
DROP VECTOR INDEX ON t_vector_row_lock_b(v);
DROP TABLE t_vector_row_lock_a;
DROP TABLE t_vector_row_lock_b;
