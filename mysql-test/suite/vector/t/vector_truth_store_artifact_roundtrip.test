--source include/have_vector_index.inc
--source include/have_vector_search_library.inc
--source include/have_debug.inc

--echo #
--echo # WL#vector-v1: roundtrip structured and row truth-store artifacts
--echo #

SELECT VEC_INDEX_CREATE('idx_truth_artifact_roundtrip', 2);
SELECT VEC_INDEX_UPSERT('idx_truth_artifact_roundtrip', 1,
                        VEC_FROMTEXT('[1,1]'));

--disable_query_log
SET @metadata_orig = VEC_DEBUG_TRUTH_STORE_GET_HEX('metadata');
SET @manifest_orig = VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest');
SET @committed_orig = VEC_DEBUG_TRUTH_STORE_GET_HEX('committed');
SET @changelog_orig = VEC_DEBUG_TRUTH_STORE_GET_HEX('changelog');
SET @prepared_orig = VEC_DEBUG_TRUTH_STORE_GET_HEX('prepared');
SET @large_hex = HEX(REPEAT('m', 70000));
SET @committed_hex = HEX('committed-row-debug');
SET @changelog_hex = HEX('changelog-row-debug');
SET @prepared_hex = HEX('prepared-row-debug');
--enable_query_log

SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('metadata', @large_hex) AS metadata_set;
SELECT LENGTH(VEC_DEBUG_TRUTH_STORE_GET_HEX('metadata')) = LENGTH(@large_hex)
  AS metadata_roundtrip;
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('manifest', @large_hex) AS manifest_set;
SELECT LENGTH(VEC_DEBUG_TRUTH_STORE_GET_HEX('manifest')) = LENGTH(@large_hex)
  AS manifest_roundtrip;

SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('committed', @committed_hex)
  AS committed_set;
SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('committed') = @committed_hex
  AS committed_roundtrip;
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('changelog', @changelog_hex)
  AS changelog_set;
SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('changelog') = @changelog_hex
  AS changelog_roundtrip;
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('prepared', @prepared_hex)
  AS prepared_set;
SELECT VEC_DEBUG_TRUTH_STORE_GET_HEX('prepared') = @prepared_hex
  AS prepared_roundtrip;

--disable_query_log
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('metadata', @metadata_orig);
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('manifest', @manifest_orig);
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('committed', @committed_orig);
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('changelog', @changelog_orig);
SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('prepared', @prepared_orig);
--enable_query_log

SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_truth_artifact_roundtrip', VEC_FROMTEXT('[1,1]'), 1),
  CAST(1 AS JSON)) AS search_after_restore;
SELECT VEC_INDEX_DROP('idx_truth_artifact_roundtrip');
