--source include/have_vector_debug_native.inc
--source include/have_vector_faiss.inc

--echo #
--echo # WL#vector-v1: persist vector index metadata across restart
--echo #

SELECT VEC_INDEX_LIST();
SET @change_log_ckpt_before = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');

SELECT VEC_INDEX_CREATE('idx_persist_mem', 3, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_CREATE('idx_persist_ext', 4, 'COSINE', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_UPSERT('idx_persist_mem', 1, VEC_FROMTEXT('[1,2,3]'));
SELECT VEC_INDEX_UPSERT('idx_persist_ext', 7, VEC_FROMTEXT('[1,0,0,1]'));

SELECT VEC_INDEX_LIST();
--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_persist_mem');
--source suite/vector/include/vector_normalize_lifecycle_build_timing_zero.inc
SELECT VEC_INDEX_INFO('idx_persist_ext');
SELECT VEC_INDEX_SEARCH('idx_persist_mem', VEC_FROMTEXT('[1,2,3]'), 1);
SELECT VEC_INDEX_SEARCH('idx_persist_ext', VEC_FROMTEXT('[1,0,0,1]'), 1);

SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_state';
SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_version';
SET @change_log_ckpt_after = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SELECT @change_log_ckpt_after > @change_log_ckpt_before;

--source include/restart_mysqld.inc

SELECT VEC_INDEX_LIST();
--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_persist_mem');
--source suite/vector/include/vector_normalize_lifecycle_build_timing_zero.inc
SELECT VEC_INDEX_INFO('idx_persist_ext');
SELECT VEC_INDEX_SEARCH('idx_persist_mem', VEC_FROMTEXT('[1,2,3]'), 1);
SELECT VEC_INDEX_SEARCH('idx_persist_ext', VEC_FROMTEXT('[1,0,0,1]'), 1);

SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_state';
SHOW VECTOR STATUS LIKE 'idx_persist_%.lifecycle_version';
SET @change_log_ckpt_restart = (
  SELECT CAST(VARIABLE_VALUE AS UNSIGNED)
  FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Vector_manifest_change_log_checkpoint');
SELECT @change_log_ckpt_restart > 0;

SELECT VEC_INDEX_DROP('idx_persist_mem');
SELECT VEC_INDEX_DROP('idx_persist_ext');
SELECT VEC_INDEX_LIST();
