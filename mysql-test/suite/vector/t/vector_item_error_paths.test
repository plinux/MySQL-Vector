SELECT VEC_INDEX_TXN_PENDING(@txn_item);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT(NULL, @txn_item, 1, VEC_FROMTEXT('[1,1]'));
