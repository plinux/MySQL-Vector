SELECT VEC_INDEX_STAGE_UPSERT('idx_item_missing', @txn_item, 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_err', @txn_item, 5, VEC_FROMTEXT('[5,5]'));
