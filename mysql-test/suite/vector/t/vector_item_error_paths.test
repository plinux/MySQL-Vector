SELECT VEC_INDEX_TXN_COMMIT(NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_COMMIT(-1);
SELECT VEC_INDEX_TXN_COMMIT(99999);
--error ER_WRONG_ARGUMENTS
