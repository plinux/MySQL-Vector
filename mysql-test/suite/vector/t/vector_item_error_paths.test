--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_PENDING(-1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_PENDING(NULL);
SELECT VEC_INDEX_TXN_PENDING(18446744073709551615);
SELECT VEC_INDEX_TXN_PENDING(99999);

