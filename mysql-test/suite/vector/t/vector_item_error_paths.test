--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK_TO(-1, 'sp_neg');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK_TO(@txn_item, '');
--error ER_WRONG_ARGUMENTS
