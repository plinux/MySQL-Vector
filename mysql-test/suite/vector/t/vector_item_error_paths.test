--source include/have_vector_debug_native.inc

--echo #
--echo # WL#vector-v1: item_vectorfunc null/error branches
--echo #

--error ER_WRONG_ARGUMENTS
SELECT VEC_TOTEXT('abc');
--error ER_WRONG_ARGUMENTS
SELECT VEC_NORMALIZE('abc');
--error ER_WRONG_ARGUMENTS
SELECT VEC_TOTEXT(x'0000C07F');
--error ER_WRONG_ARGUMENTS
SELECT VEC_DISTANCE_EUCLIDEAN(x'0000807F', VEC_FROMTEXT('[1]'));

SELECT VEC_DOT_PRODUCT(NULL, VEC_FROMTEXT('[1]'));
SELECT VEC_DOT_PRODUCT(VEC_FROMTEXT('[1]'), NULL);
SELECT VEC_INNER_PRODUCT(NULL, VEC_FROMTEXT('[1]'));
SELECT VEC_INNER_PRODUCT(VEC_FROMTEXT('[1]'), NULL);
SELECT VEC_DISTANCE_EUCLIDEAN(NULL, VEC_FROMTEXT('[1]'));
SELECT VEC_DISTANCE_EUCLIDEAN(VEC_FROMTEXT('[1]'), NULL);
SELECT VEC_DISTANCE_COSINE(NULL, VEC_FROMTEXT('[1]'));
SELECT VEC_DISTANCE_COSINE(VEC_FROMTEXT('[1]'), NULL);
SELECT VEC_DISTANCE(NULL, VEC_FROMTEXT('[1]'));
SELECT VEC_DISTANCE(VEC_FROMTEXT('[1]'), NULL);
SELECT VEC_DISTANCE(VEC_FROMTEXT('[1]'), VEC_FROMTEXT('[1]'), NULL);

--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_zero_dim', 0);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE(NULL, 2);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_dim_null', NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_null_optional', 2, NULL, NULL, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_mode_null', 2, 'EUCLIDEAN', NULL, 'NATIVE');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_provider_null', 2, 'EUCLIDEAN', 'MEMORY', NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_build_threads_null', 2, 'EUCLIDEAN',
                        'MEMORY', 'NATIVE', NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_build_threads_overflow', 2, 'EUCLIDEAN',
                        'MEMORY', 'NATIVE', 65536);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_CREATE('idx_item_err_consistency_invalid', 2, 'EUCLIDEAN',
                        'MEMORY', 'NATIVE', 0, 'invalid');

SELECT VEC_INDEX_CREATE('idx_item_err', 2);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_DROP(NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_UPSERT(NULL, 1, VEC_FROMTEXT('[1,1]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_UPSERT('idx_item_err', -1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_UPSERT('idx_item_err', 18446744073709551615,
                        VEC_FROMTEXT('[1,1]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_UPSERT('idx_item_err', 1, 'bad-vector');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_UPSERT('idx_item_err', 1, x'0000C07F0000803F');
