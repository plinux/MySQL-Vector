--source include/have_vector_index.inc

--echo #
--echo # WL#vector-v1: vector helper SQL functions
--echo #

SELECT HEX(VEC_FROMTEXT('[1,2,3]'));
SELECT VECTOR_DIM(VEC_FROMTEXT('[1,2,3]'));
SELECT VEC_TOTEXT(VEC_FROMTEXT('[1, 2, 3]'));
SELECT ROUND(VEC_DISTANCE_COSINE(VEC_NORMALIZE(VEC_FROMTEXT('[3,4]')), VEC_FROMTEXT('[0.6,0.8]')), 6);
SELECT VECTOR_DIM(VEC_FROMTEXT('[]')), VEC_TOTEXT(VEC_FROMTEXT('[]'));

SELECT ROUND(VEC_DISTANCE_EUCLIDEAN(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]')), 6);
SELECT ROUND(VEC_DISTANCE_COSINE(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 6);
SELECT ROUND(VEC_DISTANCE_COSINE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[1,2]')), 6);
SELECT ROUND(VEC_DOT_PRODUCT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]')), 6);
SELECT ROUND(VEC_INNER_PRODUCT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]')), 6);
SELECT ROUND(VEC_DISTANCE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]')), 6);
SELECT ROUND(VEC_DISTANCE(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]'), 'COSINE'), 6);
SELECT ROUND(VEC_DISTANCE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]'), ' euclidean '), 6);
SELECT ROUND(VEC_DISTANCE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]'), 'IP'), 6);
SELECT ROUND(VEC_DISTANCE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]'), 'INNER_PRODUCT'), 6);

SELECT VECTOR_DIM(NULL), VEC_TOTEXT(NULL), VEC_DISTANCE_EUCLIDEAN(NULL, VEC_FROMTEXT('[1]'));

--error ER_WRONG_ARGUMENTS
SELECT VEC_FROMTEXT('1,2,3');
--error ER_WRONG_ARGUMENTS
SELECT VECTOR_DIM('abc');
--error ER_WRONG_ARGUMENTS
SELECT VEC_DISTANCE_EUCLIDEAN(VEC_FROMTEXT('[1]'), VEC_FROMTEXT('[1,2]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_DOT_PRODUCT(VEC_FROMTEXT('[1]'), VEC_FROMTEXT('[1,2]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_INNER_PRODUCT(VEC_FROMTEXT('[1]'), VEC_FROMTEXT('[1,2]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_DISTANCE_COSINE(VEC_FROMTEXT('[0,0]'), VEC_FROMTEXT('[1,2]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_NORMALIZE(VEC_FROMTEXT('[0,0]'));
--error ER_WRONG_ARGUMENTS
SELECT VEC_DISTANCE(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[4,6]'), 'manhattan');
