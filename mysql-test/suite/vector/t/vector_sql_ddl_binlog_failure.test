--source include/have_vector_index.inc
--source include/have_debug.inc

--echo #
--echo # WL#Vector: CREATE VECTOR INDEX rolls back local state on binlog failure
--echo #

--disable_warnings
DROP TABLE IF EXISTS t_vector_ddl_binlog_fail;
--enable_warnings
CREATE TABLE t_vector_ddl_binlog_fail (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
INSERT INTO t_vector_ddl_binlog_fail VALUES
  (1, VEC_FROMTEXT('[1,1]')),
  (2, VEC_FROMTEXT('[2,2]'));

--disable_query_log
SET GLOBAL debug = '+d,vector_ddl_fail_binlog_write';
--enable_query_log

--error ER_INTERNAL_ERROR
CREATE VECTOR INDEX ON t_vector_ddl_binlog_fail(v) WITH (2);

--disable_query_log
SET GLOBAL debug = '-d,vector_ddl_fail_binlog_write';
--enable_query_log

--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_INFO('test.t_vector_ddl_binlog_fail.v');

CREATE VECTOR INDEX ON t_vector_ddl_binlog_fail(v) WITH (2);
SELECT VEC_INDEX_SEARCH('test.t_vector_ddl_binlog_fail.v',
                        VEC_FROMTEXT('[1,1]'), 1);

--disable_query_log
SET GLOBAL debug = '+d,vector_ddl_fail_binlog_write';
--enable_query_log

--error ER_INTERNAL_ERROR
DROP VECTOR INDEX ON t_vector_ddl_binlog_fail(v);

--disable_query_log
SET GLOBAL debug = '-d,vector_ddl_fail_binlog_write';
--enable_query_log

SELECT VEC_INDEX_SEARCH('test.t_vector_ddl_binlog_fail.v',
                        VEC_FROMTEXT('[1,1]'), 1);
DROP VECTOR INDEX ON t_vector_ddl_binlog_fail(v);

DROP TABLE t_vector_ddl_binlog_fail;
