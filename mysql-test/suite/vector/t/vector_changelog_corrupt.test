--source include/have_vector_debug_native.inc

--echo #
--echo # WL#vector-v1: recover corrupt changelog from a bound table
--echo #

DROP TABLE IF EXISTS t_vec_changelog_corrupt;
CREATE TABLE t_vec_changelog_corrupt (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
INSERT INTO t_vec_changelog_corrupt VALUES
  (1, VEC_FROMTEXT('[1,2]'));
CREATE VECTOR INDEX ON t_vec_changelog_corrupt(v)
  WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
INSERT INTO t_vec_changelog_corrupt VALUES
  (2, VEC_FROMTEXT('[2,3]'));
DELETE FROM t_vec_changelog_corrupt WHERE id = 1;
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
                        VEC_FROMTEXT('[2,3]'), 8);

--source suite/vector/include/vector_truth_store_backend.inc

--let $datadir=`SELECT @@datadir`
if ($is_mysql_truth_store)
{
  --disable_query_log
  --disable_result_log
  SELECT VEC_DEBUG_TRUTH_STORE_SET_HEX('changelog', '6261640a726f770a');
  --enable_result_log
  --enable_query_log
}
if (!$is_mysql_truth_store)
{
  --exec printf 'bad\nrow\n' > $datadir/mysql_vector_index/changelog.v1
}

--source include/restart_mysqld.inc

SELECT VEC_INDEX_LIST();
SELECT JSON_UNQUOTE(JSON_EXTRACT(
         VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
         '$.lifecycle_state')) AS lifecycle;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
                        VEC_FROMTEXT('[2,3]'), 8);
SELECT VEC_INDEX_RECOVER('test.t_vec_changelog_corrupt.v');
SELECT JSON_UNQUOTE(JSON_EXTRACT(
         VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
         '$.lifecycle_state')) AS lifecycle,
       JSON_EXTRACT(VEC_INDEX_INFO('test.t_vec_changelog_corrupt.v'),
                    '$.committed_entry_count') AS entries;
SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
                        VEC_FROMTEXT('[2,3]'), 8);
SHOW GLOBAL STATUS LIKE 'Vector_change_log_load_failures';
SHOW GLOBAL STATUS LIKE 'Vector_change_log_replay_failures';

--source include/restart_mysqld.inc

SELECT VEC_INDEX_SEARCH('test.t_vec_changelog_corrupt.v',
                        VEC_FROMTEXT('[2,3]'), 8);
DROP TABLE t_vec_changelog_corrupt;
