--source include/have_vector_debug_native.inc
--source include/have_vector_faiss.inc

--echo #
--echo # WL#vector-v1: item_vectorfunc index API branch coverage paths
--echo #

SELECT VEC_INDEX_LIST();

SELECT VEC_INDEX_CREATE('idx_item_api_mem', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_CREATE('idx_item_api_ext', 2, 'COSINE', 'EXTERNAL', 'FAISS');
SELECT VEC_INDEX_LIST();

--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_api_mem');
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_api_ext');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_INFO('idx_item_api_missing');

PREPARE ps_vec_dim FROM 'SELECT VECTOR_DIM(?)';
SET @ps_vec_dim_arg = VEC_FROMTEXT('[1,2,3]');
EXECUTE ps_vec_dim USING @ps_vec_dim_arg;
DEALLOCATE PREPARE ps_vec_dim;

PREPARE ps_vec_distance FROM 'SELECT ROUND(VEC_DISTANCE(?, ?, ?), 6)';
SET @ps_vec_distance_lhs = VEC_FROMTEXT('[1,0]');
SET @ps_vec_distance_rhs = VEC_FROMTEXT('[0,1]');
SET @ps_vec_distance_metric = 'COSINE';
EXECUTE ps_vec_distance USING @ps_vec_distance_lhs, @ps_vec_distance_rhs,
  @ps_vec_distance_metric;
DEALLOCATE PREPARE ps_vec_distance;

SELECT VEC_INDEX_UPSERT('idx_item_api_mem', 1, '[1,2]');
SELECT VEC_INDEX_UPSERT('idx_item_api_mem', 2, VEC_FROMTEXT('[2,2]'));
SELECT VEC_INDEX_SEARCH('idx_item_api_mem', VEC_FROMTEXT('[1,2]'), 0);
SELECT VEC_INDEX_SEARCH('idx_item_api_mem', VEC_FROMTEXT('[1,2]'), 5);
SELECT VEC_INDEX_SEARCH_BATCH('idx_item_api_mem',
  CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]')), 2, 5);
SELECT VEC_INDEX_SEARCH_BATCH('idx_item_api_mem',
  CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]')), 2, 0);
SELECT VEC_INDEX_UPSERT('idx_item_api_ext', 1, '[1,0]');
SELECT VEC_INDEX_UPSERT('idx_item_api_ext', 2, '[0,1]');
SELECT VEC_INDEX_SEARCH_BATCH('idx_item_api_ext',
  CONCAT(VEC_FROMTEXT('[1,0]'), VEC_FROMTEXT('[0,1]')), 2, 2);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH('idx_item_api_mem', VEC_FROMTEXT('[1,2]'), 0, 5);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH('idx_item_api_mem',
  CONCAT(VEC_FROMTEXT('[1,2]'), X'00'), 1, 5);
SET @batch_index_name = 'idx_item_api_mem';
SET @batch_payload = CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]'));
SET @batch_query_count = 1;
SET @batch_top_k = -1;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_index_name = NULL;
SET @batch_top_k = 5;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_index_name = 'idx_item_api_mem';
SET @batch_query_count = NULL;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_query_count = 1;
SET @batch_top_k = NULL;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_top_k = 5;
SET @batch_payload = X'';
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_payload = VEC_FROMTEXT('[1,2]');
SET @batch_query_count = 3;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_index_name = 'idx_item_api_missing';
SET @batch_payload = CONCAT(VEC_FROMTEXT('[1,2]'), VEC_FROMTEXT('[2,2]'));
SET @batch_query_count = 2;
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH_BATCH(@batch_index_name, @batch_payload, @batch_query_count,
  @batch_top_k);
SET @batch_index_name = NULL;
SET @batch_payload = NULL;
SET @batch_query_count = NULL;
SET @batch_top_k = NULL;
SELECT VEC_INDEX_SEARCH_WITH_DISTANCE('idx_item_api_mem', VEC_FROMTEXT('[1,2]'), 5);
SELECT VEC_INDEX_ERASE('idx_item_api_mem', 2);
SELECT VEC_INDEX_SEARCH('idx_item_api_mem', VEC_FROMTEXT('[1,2]'), 5);

SET @txn_item_api = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_TXN_PENDING(@txn_item_api);
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api, 3, '[3,3]');
SELECT VEC_INDEX_STAGE_ERASE('idx_item_api_mem', @txn_item_api, 1);
SELECT VEC_INDEX_TXN_PENDING(@txn_item_api);
SELECT VEC_INDEX_TXN_SAVEPOINT(@txn_item_api, 'sp_item_api');
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api, 4, VEC_FROMTEXT('[4,4]'));
SELECT VEC_INDEX_TXN_ROLLBACK_TO(@txn_item_api, 'sp_item_api');
SELECT VEC_INDEX_TXN_RELEASE_SAVEPOINT(@txn_item_api, 'sp_item_api');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_RELEASE_SAVEPOINT(@txn_item_api, 'sp_item_api');
SELECT VEC_INDEX_TXN_COMMIT(@txn_item_api);
SELECT VEC_INDEX_SEARCH('idx_item_api_mem', VEC_FROMTEXT('[3,3]'), 5);

SET @txn_item_api2 = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api2, 9, '[9,9]');
SELECT VEC_INDEX_TXN_ROLLBACK(@txn_item_api2);
SELECT VEC_INDEX_SEARCH('idx_item_api_mem', VEC_FROMTEXT('[9,9]'), 5);

--echo # item transaction functions reject malformed user input
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_PENDING(NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_PENDING(-1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT(NULL, @txn_item_api2, 1, '[1,1]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', NULL, 1, '[1,1]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api2, NULL, '[1,1]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api2, 1, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_mem', @txn_item_api2, 1, '[1]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_missing', @txn_item_api2, 1, '[1,1]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_ERASE(NULL, @txn_item_api2, 1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_ERASE('idx_item_api_mem', NULL, 1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_ERASE('idx_item_api_mem', @txn_item_api2, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_STAGE_ERASE('idx_item_api_missing', @txn_item_api2, 1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_COMMIT(NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_COMMIT(-1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK(NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK(-1);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_SAVEPOINT(NULL, 'sp_bad');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_SAVEPOINT(@txn_item_api2, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_SAVEPOINT(@txn_item_api2, '');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK_TO(NULL, 'sp_bad');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK_TO(@txn_item_api2, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_ROLLBACK_TO(@txn_item_api2, '');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_RELEASE_SAVEPOINT(NULL, 'sp_bad');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_RELEASE_SAVEPOINT(@txn_item_api2, NULL);
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_TXN_RELEASE_SAVEPOINT(@txn_item_api2, '');

SELECT VEC_INDEX_REBUILD('idx_item_api_mem');
SELECT VEC_INDEX_RECOVER('idx_item_api_mem');
SELECT VEC_INDEX_REBUILD_ALL();
SELECT VEC_INDEX_RECOVER_ALL();

SELECT VEC_INDEX_CREATE('idx_item_api_fail', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SET @txn_item_api_fail = VEC_INDEX_TXN_BEGIN();
SELECT VEC_INDEX_STAGE_UPSERT('idx_item_api_fail', @txn_item_api_fail, 11, '[11,11]');
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_REBUILD('idx_item_api_fail');
--replace_regex /"lifecycle_version":[0-9]+/"lifecycle_version":<num>/ /"last_error_ts":[0-9]+/"last_error_ts":<num>/ /"last_apply_latency_ms":[0-9]+/"last_apply_latency_ms":<num>/ /"last_recover_fallback_ts":[0-9]+/"last_recover_fallback_ts":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_api_fail');
SELECT VEC_INDEX_TXN_ROLLBACK(@txn_item_api_fail);
SELECT VEC_INDEX_RECOVER('idx_item_api_fail');
--replace_regex /"lifecycle_version":[0-9]+/"lifecycle_version":<num>/ /"last_error_ts":[0-9]+/"last_error_ts":<num>/ /"last_apply_latency_ms":[0-9]+/"last_apply_latency_ms":<num>/ /"last_recover_fallback_ts":[0-9]+/"last_recover_fallback_ts":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_api_fail');
SELECT VEC_INDEX_DROP('idx_item_api_fail');

SELECT VEC_INDEX_DROP('idx_item_api_mem');
SELECT VEC_INDEX_DROP('idx_item_api_ext');
SELECT VEC_INDEX_LIST();
