--source include/have_vector_debug_native.inc
--source include/have_vector_faiss.inc

--echo #
--echo # WL#vector-v1: SHOW VECTOR STATUS index state rows
--echo #

SELECT VEC_INDEX_CREATE('idx_mem', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_CREATE('idx_ext', 2, 'COSINE', 'EXTERNAL', 'FAISS');

SHOW VECTOR STATUS LIKE 'idx_mem.metric';
SHOW VECTOR STATUS FOR INDEX idx_mem
  WHERE Variable_name NOT LIKE '%.index_identity'
    AND Variable_name NOT LIKE '%.%generation';
--source suite/vector/include/vector_normalize_status_generations.inc
SHOW VECTOR STATUS FOR INDEX idx_mem
  WHERE Variable_name LIKE '%.index_identity'
     OR Variable_name LIKE '%.%generation';
SHOW VECTOR STATUS LIKE 'idx_ext.metric';
SHOW VECTOR STATUS FOR INDEX idx_ext
  WHERE Variable_name NOT LIKE '%.index_identity'
    AND Variable_name NOT LIKE '%.%generation'
    AND Variable_name NOT LIKE '%.backend_build_resource_%'
    AND Variable_name != 'idx_ext.backend_build_effective_threads'
    AND Variable_name != 'idx_ext.backend_build_effective_blas_threads'
    AND Variable_name != 'idx_ext.backend_build_pq_train_threads'
    AND Variable_name != 'idx_ext.backend_build_pq_compress_threads'
    AND Variable_name != 'idx_ext.scheduler_cpu_budget'
    AND Variable_name != 'idx_ext.scheduler_effective_build_threads'
    AND Variable_name != 'idx_ext.scheduler_effective_blas_threads'
    AND Variable_name != 'idx_ext.scheduler_pq_train_threads'
    AND Variable_name != 'idx_ext.scheduler_pq_compress_threads';
--source suite/vector/include/vector_normalize_resource_threads.inc
SHOW VECTOR STATUS FOR INDEX idx_ext
  WHERE Variable_name = 'idx_ext.backend_build_effective_threads'
     OR Variable_name = 'idx_ext.backend_build_effective_blas_threads'
     OR Variable_name = 'idx_ext.backend_build_pq_train_threads'
     OR Variable_name = 'idx_ext.backend_build_pq_compress_threads'
     OR Variable_name = 'idx_ext.scheduler_cpu_budget'
     OR Variable_name = 'idx_ext.scheduler_effective_build_threads'
     OR Variable_name = 'idx_ext.scheduler_effective_blas_threads'
     OR Variable_name = 'idx_ext.scheduler_pq_train_threads'
     OR Variable_name = 'idx_ext.scheduler_pq_compress_threads';
--source suite/vector/include/vector_normalize_build_resources.inc
SHOW VECTOR STATUS FOR INDEX idx_ext
  WHERE Variable_name LIKE '%.backend_build_resource_%';
--source suite/vector/include/vector_normalize_status_generations.inc
SHOW VECTOR STATUS FOR INDEX idx_ext
  WHERE Variable_name LIKE '%.index_identity'
     OR Variable_name LIKE '%.%generation';
SHOW VECTOR STATUS WHERE Section = 'SYNC_PIPELINE'
  AND Variable_name LIKE 'idx_ext.%';

DROP TABLE IF EXISTS t_vec_status_meta;
CREATE TABLE t_vec_status_meta (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;
CREATE VECTOR INDEX ON t_vec_status_meta(v) WITH (2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
--replace_regex /last_apply_latency_ms":[0-9]+/last_apply_latency_ms":<num>/
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('test.t_vec_status_meta.v');
SHOW VECTOR STATUS FOR INDEX 'test.t_vec_status_meta.v'
  WHERE Section = 'INDEX_STATE'
    AND Variable_name NOT LIKE '%.index_identity'
    AND Variable_name NOT LIKE '%.%generation';
--source suite/vector/include/vector_normalize_status_generations.inc
SHOW VECTOR STATUS FOR INDEX 'test.t_vec_status_meta.v'
  WHERE Section = 'INDEX_STATE'
    AND Variable_name LIKE '%.index_identity';
--source suite/vector/include/vector_normalize_status_generations.inc
SHOW VECTOR STATUS FOR INDEX 'test.t_vec_status_meta.v'
  WHERE Section = 'INDEX_STATE'
    AND Variable_name LIKE '%.%generation';
DROP VECTOR INDEX ON t_vec_status_meta(v);
DROP TABLE t_vec_status_meta;

SELECT VEC_INDEX_DROP('idx_mem');
SELECT VEC_INDEX_DROP('idx_ext');

SHOW VECTOR STATUS LIKE 'idx_mem.%';
SHOW VECTOR STATUS LIKE 'idx_ext.%';
