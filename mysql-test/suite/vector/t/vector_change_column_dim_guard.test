--source include/have_vector_index.inc
--source include/have_vector_search_library.inc

--echo #
--echo # WL#vector-v1: block CHANGE/MODIFY on indexed VECTOR column
--echo #

DROP TABLE IF EXISTS t_vector_change_dim_guard;
CREATE TABLE t_vector_change_dim_guard (
  id INT PRIMARY KEY,
  v VECTOR(2)
) ENGINE=InnoDB;

CREATE VECTOR INDEX ON t_vector_change_dim_guard(v) WITH (2);

--error ER_NOT_SUPPORTED_YET
ALTER TABLE t_vector_change_dim_guard CHANGE COLUMN v w VECTOR(3);
--error ER_NOT_SUPPORTED_YET
ALTER TABLE t_vector_change_dim_guard CHANGE COLUMN v v VECTOR(3);
--error ER_NOT_SUPPORTED_YET
ALTER TABLE t_vector_change_dim_guard MODIFY COLUMN v VECTOR(3);

SHOW VECTOR STATUS LIKE 'test.t_vector_change_dim_guard.v.dimension';
DROP TABLE t_vector_change_dim_guard;
