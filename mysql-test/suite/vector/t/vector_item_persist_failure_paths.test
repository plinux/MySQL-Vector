--source include/have_vector_debug_native.inc

--echo #
--echo # WL#vector-v1: recover committed statement publications after persist failure
--echo #

CALL mtr.add_suppression(
  "Vector runtime publication failed after transaction commit at stage");

SELECT VEC_INDEX_CREATE('idx_item_pf_a', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_CREATE('idx_item_pf_b', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
SELECT VEC_INDEX_UPSERT('idx_item_pf_a', 1, VEC_FROMTEXT('[1,1]'));
SELECT VEC_INDEX_SEARCH('idx_item_pf_a', VEC_FROMTEXT('[1,1]'), 5);

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_CREATE('idx_item_pf_create_fail', 2, 'EUCLIDEAN', 'MEMORY', 'NATIVE');
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_LIST();

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_UPSERT('idx_item_pf_a', 2, VEC_FROMTEXT('[2,2]'));
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_SEARCH('idx_item_pf_a', VEC_FROMTEXT('[2,2]'), 5);

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_ERASE('idx_item_pf_a', 1);
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_SEARCH('idx_item_pf_a', VEC_FROMTEXT('[1,1]'), 5);

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_REBUILD('idx_item_pf_a');
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_pf_a');

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_RECOVER('idx_item_pf_a');
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
--source suite/vector/include/vector_normalize_lifecycle.inc
SELECT VEC_INDEX_INFO('idx_item_pf_a');

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_REBUILD_ALL();
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_LIST();

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_RECOVER_ALL();
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_LIST();

--disable_query_log
SET GLOBAL debug = '+d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_DROP('idx_item_pf_b');
--disable_query_log
SET GLOBAL debug = '-d,vector_truth_store_fail_save';
--enable_query_log
SELECT VEC_INDEX_LIST();
SELECT VEC_INDEX_SEARCH('idx_item_pf_a', VEC_FROMTEXT('[1,1]'), 5);
SELECT VEC_INDEX_DROP('idx_item_pf_a');
SELECT VEC_INDEX_DROP('idx_item_pf_create_fail');
