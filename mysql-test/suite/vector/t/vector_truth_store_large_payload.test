--source include/have_vector_hnsw.inc

--echo #
--echo # WL#vector-v1: persist large vector truth rows through InnoDB LONGBLOB
--echo #

SELECT VEC_INDEX_CREATE('idx_large_truth_payload', 1024, 'EUCLIDEAN',
                        'MEMORY', 'HNSWLIB');
SET @large_vector = CONCAT('[', REPEAT('1,', 1023), '1]');
SELECT VEC_INDEX_UPSERT('idx_large_truth_payload', 1,
                        VEC_FROMTEXT(@large_vector));
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_large_truth_payload', VEC_FROMTEXT(@large_vector), 1),
  CAST(1 AS JSON));
SET @large_vector_2 = CONCAT('[', REPEAT('2,', 1023), '2]');
SELECT VEC_INDEX_UPSERT('idx_large_truth_payload', 1,
                        VEC_FROMTEXT(@large_vector_2));
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_large_truth_payload', VEC_FROMTEXT(@large_vector_2), 1),
  CAST(1 AS JSON));
SELECT VEC_INDEX_ERASE('idx_large_truth_payload', 1);
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_large_truth_payload', VEC_FROMTEXT(@large_vector_2), 1),
  CAST(1 AS JSON));
SELECT VEC_INDEX_UPSERT('idx_large_truth_payload', 1,
                        VEC_FROMTEXT(@large_vector));

--source include/restart_mysqld.inc

SET @large_vector = CONCAT('[', REPEAT('1,', 1023), '1]');
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_large_truth_payload', VEC_FROMTEXT(@large_vector), 1),
  CAST(1 AS JSON));
SELECT VEC_INDEX_DROP('idx_large_truth_payload');
