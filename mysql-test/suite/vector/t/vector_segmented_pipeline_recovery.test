--source include/have_vector_debug_native.inc

--echo #
--echo # WL#Vector: segmented build task recovery guard
--echo #

SET @old_vector_build_pipeline_mode = @@GLOBAL.vector_build_pipeline_mode;
SET GLOBAL vector_build_pipeline_mode = 'segmented';

SELECT VEC_INDEX_CREATE('idx_segmented_recovery', 2, 'EUCLIDEAN', 'MEMORY',
                        'NATIVE', 0, 'standalone');
SELECT VEC_INDEX_UPSERT('idx_segmented_recovery', 1, '[1,0]');

SET GLOBAL debug = '+d,vector_segment_task_before_publish';
--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_BULK_BUILD('idx_segmented_recovery');
SET GLOBAL debug = '-d,vector_segment_task_before_publish';

--error ER_WRONG_ARGUMENTS
SELECT VEC_INDEX_SEARCH('idx_segmented_recovery', VEC_FROMTEXT('[1,0]'), 1);

SELECT VEC_INDEX_BULK_BUILD('idx_segmented_recovery') AS successful_build;
SELECT JSON_UNQUOTE(JSON_EXTRACT(VEC_INDEX_INFO('idx_segmented_recovery'),
                                 '$.build_pipeline_decision')) AS decision;
SELECT JSON_CONTAINS(
  VEC_INDEX_SEARCH('idx_segmented_recovery', VEC_FROMTEXT('[1,0]'), 1),
  CAST(1 AS JSON)) AS doc_visible_after_rebuild;

SET GLOBAL vector_build_pipeline_mode = @old_vector_build_pipeline_mode;
SELECT VEC_INDEX_DROP('idx_segmented_recovery');
