# Check information_schema.tables while vector INFORMATION_SCHEMA tables are
# present.

--source include/have_vector_index.inc

let $my_where = WHERE table_schema = 'information_schema'
AND table_name COLLATE utf8_general_ci <> 'profiling'
AND table_name COLLATE utf8_general_ci not like 'innodb_%'
AND table_name not like 'ndb%';
--source suite/funcs_1/datadict/tables1.inc
