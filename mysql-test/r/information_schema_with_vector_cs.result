SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES';
TABLE_NAME
VECTOR_LIBRARIES
SELECT COUNT(*) AS vector_libraries_table_count
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES';
vector_libraries_table_count
1
SELECT COLUMN_NAME, DATA_TYPE
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'information_schema'
  AND TABLE_NAME = 'VECTOR_LIBRARIES'
ORDER BY ORDINAL_POSITION;
COLUMN_NAME	DATA_TYPE
LIBRARY	varchar
SUPPORT	varchar
COMMENT	varchar
