+    fn shared_store_key(context: u64, key: &[u8]) -> Vec<u8> {
+        let context = context & TERM_BITMASK;
+        let mut stored_key = Vec::new();
+        stored_key.extend_from_slice(bytemuck::bytes_of(&context));
+        stored_key.extend_from_slice(key);
