+        _context: &<GarnetProvider<T> as DataProvider>::Context,
+        _batch: &std::sync::Arc<B>,
+        _ids: Itr,
+    ) -> impl std::future::Future<Output = Result<Self::Seed, Self::FinishError>> + Send
+    where
+        Itr: ExactSizeIterator<Item = <GarnetProvider<T> as DataProvider>::InternalId> + Send,
+    {
+        future::ready(Ok(workingset::map::Builder::new(
