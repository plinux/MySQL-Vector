+/// # Safety
+///
+/// FFI. This experimental extension exposes DiskANN `multi_insert` to native
+/// callers that can provide a stable contiguous batch during the call.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn bulk_insert(
+    ctx: u64,
+    index_ptr: *const c_void,
+    id_data: *const u8,
+    id_len: usize,
+    id_stride: usize,
+    vector_value_type: VectorValueType,
+    vector_data: *const u8,
+    vector_len: usize,
+    vector_stride: usize,
+    count: usize,
+    _batch_size: usize,
+) -> bool {
+    if index_ptr.is_null() {
+        return false;
+    }
+    if count == 0 {
+        return true;
+    }
+    if id_data.is_null() || vector_data.is_null() || id_len == 0 || id_stride < id_len {
+        return false;
+    }
+
+    let index = unsafe { &*index_ptr.cast::<Index>() };
+    let ctx = Context(ctx);
+
+    let vector_width = match vector_value_type {
+        VectorValueType::FP32 => vector_len.checked_mul(mem::size_of::<f32>()),
+        VectorValueType::XB8 => Some(vector_len),
+        VectorValueType::Invalid => None,
+    };
+    let vector_width = match vector_width {
+        Some(width) if width != 0 && vector_stride >= width => width,
+        _ => return false,
+    };
+
+    let ids_len = match count.checked_mul(id_stride) {
+        Some(len) => len,
+        None => return false,
+    };
+    let vectors_len = match count.checked_mul(vector_stride) {
+        Some(len) => len,
+        None => return false,
+    };
+    let id_bytes = unsafe { slice::from_raw_parts(id_data, ids_len) };
+    let vector_bytes = unsafe { slice::from_raw_parts(vector_data, vectors_len) };
+
+    let mut ids = Vec::with_capacity(count);
+    for row in 0..count {
+        const OFFSET: usize = 0;
+        let offset = row * id_stride + OFFSET;
+        ids.push(GarnetId::from(&id_bytes[offset..offset + id_len]));
+    }
+
+    let first_vector_ptr = vector_bytes.as_ptr();
+    let first_vector = if let Some(v) = interpret_vector(
+        index.quant_type,
+        vector_value_type,
+        &first_vector_ptr,
+        vector_len,
+    ) {
+        v
+    } else {
+        return false;
+    };
+    if let Some(_err) = ensure_index_ready_or_init(index, || {
+        index.inner.maybe_set_start_point(&ctx, &first_vector).err()
+    }) {
+        return false;
+    };
+
+    if vector_stride == vector_width {
+        return index
+            .inner
+            .bulk_insert(&ctx, Arc::from(ids), vector_bytes, vector_len)
+            .is_ok();
+    }
+
+    let mut contiguous = Vec::with_capacity(count * vector_width);
+    for row in 0..count {
+        let offset = row * vector_stride;
+        contiguous.extend_from_slice(&vector_bytes[offset..offset + vector_width]);
+    }
+    index
+        .inner
+        .bulk_insert(&ctx, Arc::from(ids), &contiguous, vector_len)
+        .is_ok()
+}
