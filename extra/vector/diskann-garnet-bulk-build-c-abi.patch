+    unsafe extern "C" fn shared_write(
+        ctx: u64,
+        id_bytes: *const u8,
+        id_len: usize,
+        val_bytes: *const u8,
+        val_len: usize,
+    ) -> bool {
+        let id = unsafe { slice::from_raw_parts(id_bytes, id_len) };
+        let value = unsafe { slice::from_raw_parts(val_bytes, val_len) };
+        let mut store = shared_store().lock().unwrap();
+        store.insert(shared_store_key(ctx, id), value.to_owned());
+        true
+    }
+
+    unsafe extern "C" fn shared_delete(ctx: u64, id_bytes: *const u8, id_len: usize) -> bool {
+        let id = unsafe { slice::from_raw_parts(id_bytes, id_len) };
+        let mut store = shared_store().lock().unwrap();
+        store.remove(&shared_store_key(ctx, id));
+        true
+    }
